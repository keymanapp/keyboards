c ============================================================
c Amuzgo Keyboard - Teclado Amuzgo Guerrero /Ñomndaa
c Autor: Odiseo Trinidad López
c Base: Distribucion Latinoamericana Mod MSKLC
c ============================================================


store(&VERSION) '17.0'
store(&COPYRIGHT) '© 2026 Odiseo Trinidad López'

c ===============================================
store(&LAYOUTFILE) 'amuzgo_nomndaa.keyman-touch-layout'

store(&NAME) 'Ñomndaa (Amuzgo de Guerrero)'
store(&KEYBOARDVERSION) '3.2.2'
store(&TARGETS) 'any'
store(&VISUALKEYBOARD) 'amuzgo_nomndaa.kvks'
store(&BITMAP) 'amuzgo_nomndaa.ico'
store(&MESSAGE) 'Teclado para escribir ñomndaa (amuzgo de Guerrero) sobre la distribución Español (Latinoamérica).'
begin Unicode > use(Main)
begin NewContext > use(NewContext)
begin PostKeystroke > use(PostKeystroke)

store(default-alpha) 'a' 'A' 'b' 'B' 'c' 'C' 'd' 'D' 'e' 'E' 'f' 'F' 'g' 'G' 'h' 'H' 'i' 'I' 'j' 'J' 'k' 'K' 'l' 'L' 'm' 'M' 'n' 'N' 'ñ' 'Ñ' 'o' 'O' 'p' 'P' 'q' 'Q' 'r' 'R' 's' 'S' 't' 'T' 'u' 'U' 'v' 'V' 'w' 'W' 'x' 'X' 'y' 'Y' 'z' 'Z'
store(digit) '0'..'9'
store(sentencePunctuation) '.?!¿¡'

$keymanweb: store(&CasedKeys) [K_A]..[K_Z] [K_COLON]
group(main) using keys

+ [K_SPACE] > U+0020


+ [NCAPS K_0] > U+0030

+ [NCAPS SHIFT K_0] > U+003d

+ [CAPS K_0] > U+0030

+ [CAPS SHIFT K_0] > U+003d



