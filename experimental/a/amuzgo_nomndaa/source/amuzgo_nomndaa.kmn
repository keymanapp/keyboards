c Pasa al grupo deadkeys para resolver todos los dead keys

match > use(deadkeys)

c ============================================================

c GRUPO deadkeys: resuelve todos los dead keys

c Sin "using keys" - Ya que Keyman prioriza la regla mas larga automaticamente

c dk(007c)+RALT+K_O tiene prioridad sobre dk(007c)+K_O solo

c ============================================================

group(deadkeys)



c --- DEAD KEY CIRCUNFLEJO (007c) ---

c Cubre SOLO a e i o con circunflejo - sin u circunflejo (no existe en Amuzgo)

c Las reglas dk(007c)+RALT+K_O estan en grupo main donde la sintaxis es valida

store(dkf007c) U+0020 U+0061 U+0041 U+0065 U+0045 U+0069 U+0049 U+006f U+004f

store(dkt007c) U+005e U+00e2 U+00c2 U+00ea U+00ca U+00ee U+00ce U+00f4 U+00d4

dk(007c) any(dkf007c) > index(dkt007c, 2)



store(dkf00b4) U+0020 U+0061 U+0041 U+0065 U+0045 U+0069 U+0049 U+006f U+004f U+0075 U+0055 U+0079 U+0059

store(dkt00b4) U+00b4 U+00e1 U+00c1 U+00e9 U+00c9 U+00ed U+00cd U+00f3 U+00d3 U+00fa U+00da U+00fd U+00dd

dk(00b4) any(dkf00b4) > index(dkt00b4, 2)



store(dkf00a8) U+0020 U+0061 U+0041 U+0065 U+0045 U+0069 U+0049 U+006f U+004f U+0075 U+0055 U+0079

store(dkt00a8) U+00a8 U+00e4 U+00c4 U+00eb U+00cb U+00ef U+00cf U+00f6 U+00d6 U+00fc U+00dc U+00ff

dk(00a8) any(dkf00a8) > index(dkt00a8, 2)



store(dkf0060) U+0020 U+0061 U+0041 U+0065 U+0045 U+0069 U+0049 U+006f U+004f U+0075 U+0055

store(dkt0060) U+0060 U+00e0 U+00c0 U+00e8 U+00c8 U+00ec U+00cc U+00f2 U+00d2 U+00f9 U+00d9

dk(0060) any(dkf0060) > index(dkt0060, 2)

group(Touch) using keys

group(NewContext) readonly
    platform('touch') > use(detectStartOfSentence)

store(sentEnd) '.' '!' '?' U+2026

group(PostKeystroke) readonly
    c Mantener la capa caps sin cambios automáticos
    platform('touch') if(&layer = 'caps') > context

    c Mantener la capa numérica al teclear dígitos
    platform('touch') if(&newLayer = "") if(&layer = 'numeric') any(digit) > context

    c Si el usuario no cambió manualmente de capa, evaluar la lógica de mayúsculas
    platform('touch') if(&newLayer = "") > use(detectStartOfSentence)

group(detectStartOfSentence) readonly
    c 1. Inicio absoluto de texto/campo
    nul > layer('shift')  

    c 2. Tras un salto de línea (LF, CR o CRLF)
    U+000A > layer('shift')
    U+000D > layer('shift')
    U+000D U+000A > layer('shift')

    c 3. Tras signo de puntuación final seguido de espacio
    any(sentEnd) U+0020 > layer('shift')

    c 4. Caso por defecto (capa normal)
    nomatch > layer('default')
