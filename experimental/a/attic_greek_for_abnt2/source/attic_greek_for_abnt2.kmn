dk(iunder_tilde) + [SHIFT K_Y] > 'Ϋ'

c --- UPSILON: macron/breve + breathing ---
c Same rationale as ALPHA/IOTA above. Uppercase smooth (psili) has no Unicode
c form at all, so — matching the fallback already used in upsilon_upper above —
c macron_smooth/breve_smooth on SHIFT K_Y fall back to the lowercase-based glyph.
dk(macron_smooth) + [K_Y]       > 'ὐ' U+0304
dk(macron_smooth) + [SHIFT K_Y] > 'ὐ' U+0304
dk(macron_rough)  + [K_Y]       > 'ὑ' U+0304
