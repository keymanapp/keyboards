dk(rough) + [SHIFT K_I] > 'Ἱ'
dk(tilde) + [K_I]       > 'ῖ'
dk(tilde) + [SHIFT K_I] > 'ῖ'
dk(iunder) + [K_I]       > 'ϊ'
dk(iunder) + [SHIFT K_I] > 'Ϊ'
