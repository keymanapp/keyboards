store(&NAME) 'Attic Greek for ABNT2 keyboards'
store(&COPYRIGHT) '©2026 Marcelo dos Santos Netto'
store(&KEYBOARDVERSION) '1.0'
store(&MESSAGE) 'A keyboard for ancient Attic Greek designed for ABNT2 Brazilian Portuguese keyboard users.'
store(&TARGETS) 'windows macosx linux'
store(&VISUALKEYBOARD) 'atticgreekabnt2.kvks'
store(&KMW_HELPFILE) 'attic_greek_for_abnt2-help.htm'

begin Unicode > use(main)

c ================================
c CASED KEYS
c ================================
c Registering the base letter keys here tells Keyman to treat Caps Lock as
c equivalent to Shift for matching purposes (with the standard inversion:
c Shift+CapsLock together fall back to the unshifted/lowercase rule). This
c removes the KM020AD ambiguity warnings that appeared because keys_caps
c previously defined explicit [CAPS key] rules alongside plain, unmodified
c key references used throughout the vowel/deadkey rules below — Keyman was
c unable to tell whether those plain references should also match while
c Caps Lock is engaged. With &CasedKeys, the separate keys_caps store and its
c rule (which duplicated keys_shift's output) are no longer needed.
store(&CasedKeys) [K_A] [K_B] [K_G] [K_D] [K_E] [K_Z] [K_H] [K_U] [K_I] [K_K] [K_L] [K_M] [K_N] [K_J] [K_O] [K_P] [K_R] [K_S] [K_W] [K_T] [K_Y] [K_F] [K_X] [K_C] [K_V]

store(keys_lower) [K_A] [K_B] [K_G] [K_D] [K_E] [K_Z] [K_H] [K_U] [K_I] [K_K] [K_L] [K_M] [K_N] [K_J] [K_O] [K_P] [K_R] [K_S] [K_W] [K_T] [K_Y] [K_F] [K_X] [K_C]
store(keys_shift) [SHIFT K_A] [SHIFT K_B] [SHIFT K_G] [SHIFT K_D] [SHIFT K_E] [SHIFT K_Z] [SHIFT K_H] [SHIFT K_U] [SHIFT K_I] [SHIFT K_K] [SHIFT K_L] [SHIFT K_M] [SHIFT K_N] [SHIFT K_J] [SHIFT K_O] [SHIFT K_P] [SHIFT K_R] [SHIFT K_S] [SHIFT K_W] [SHIFT K_T] [SHIFT K_Y] [SHIFT K_F] [SHIFT K_X] [SHIFT K_C]
store(greek_lower) 'αβγδεζηθικλμνξοπρσςτυφχψ'
store(greek_upper) 'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΣΤΥΦΧΨ'

c ================================
c ALPHA stores
c ================================
c dks: macron breve acute grave smooth rough tilde iunder acute_smooth grave_smooth acute_rough grave_rough tilde_smooth tilde_rough iunder_acute iunder_grave iunder_smooth iunder_rough iunder_tilde iunder_tilde_smooth iunder_tilde_rough iunder_acute_smooth iunder_acute_rough iunder_grave_smooth iunder_grave_rough
c note: macron_smooth, macron_rough, breve_smooth and breve_rough (quantity mark +
c       breathing) are NOT part of this any()/index() aligned list: Unicode has no
c       precomposed character for those combinations, so their output is a TWO
c       codepoint combining sequence, which would break the 1-item-per-character
c       alignment this list depends on. They are handled as explicit rules in the
c       ALPHA block below instead. See "MACRON + BREATHING" / "BREVE + BREATHING"
c       in the deadkey normalization section for how the deadkeys are formed.
store(alpha_dks)   dk(macron) dk(breve) dk(acute) dk(grave) dk(smooth) dk(rough) dk(tilde) dk(iunder) dk(acute_smooth) dk(grave_smooth) dk(acute_rough) dk(grave_rough) dk(tilde_smooth) dk(tilde_rough) dk(iunder_acute) dk(iunder_grave) dk(iunder_smooth) dk(iunder_rough) dk(iunder_tilde) dk(iunder_tilde_smooth) dk(iunder_tilde_rough) dk(iunder_acute_smooth) dk(iunder_acute_rough) dk(iunder_grave_smooth) dk(iunder_grave_rough)
store(alpha_lower) 'ᾱᾰάὰἀἁᾶᾳἄἂἅἃἆἇᾴᾲᾀᾁᾷᾆᾇᾄᾅᾂᾃ'
store(alpha_upper) 'ᾹᾸΆῺἈἉἆᾼἌἊἍἋἎἏᾴᾲᾈᾉῼᾎᾏᾌᾍᾊᾋ'

c ================================
c EPSILON stores
c ================================
c dks: acute grave smooth rough acute_smooth grave_smooth acute_rough grave_rough
c note: epsilon is always short in Attic Greek, so it never takes a macron/breve;
c       no macron/breve(+breathing) combinations exist for this vowel.
store(eps_dks)   dk(acute) dk(grave) dk(smooth) dk(rough) dk(acute_smooth) dk(grave_smooth) dk(acute_rough) dk(grave_rough)
store(eps_lower) 'έὲἐἑἔἒἕἓ'
store(eps_upper) 'ΈῈἘἙἜἚἝἛ'

c ================================
c ETA stores
c ================================
c dks: acute grave smooth rough tilde iunder acute_smooth grave_smooth acute_rough grave_rough tilde_smooth tilde_rough iunder_acute iunder_grave iunder_smooth iunder_rough iunder_tilde iunder_tilde_smooth iunder_tilde_rough iunder_acute_smooth iunder_acute_rough iunder_grave_smooth iunder_grave_rough
c note: uppercase tilde/iunder_acute/iunder_grave/iunder_tilde have no Unicode uppercase form; lowercase chars used
c note: eta is always long in Attic Greek, so it never takes a macron/breve;
c       no macron/breve(+breathing) combinations exist for this vowel.
store(eta_dks)   dk(acute) dk(grave) dk(smooth) dk(rough) dk(tilde) dk(iunder) dk(acute_smooth) dk(grave_smooth) dk(acute_rough) dk(grave_rough) dk(tilde_smooth) dk(tilde_rough) dk(iunder_acute) dk(iunder_grave) dk(iunder_smooth) dk(iunder_rough) dk(iunder_tilde) dk(iunder_tilde_smooth) dk(iunder_tilde_rough) dk(iunder_acute_smooth) dk(iunder_acute_rough) dk(iunder_grave_smooth) dk(iunder_grave_rough)
store(eta_lower) 'ήὴἠἡῆῃἤἢἥἣἦἧῄῂᾐᾑῇᾖᾗᾔᾕᾒᾓ'
store(eta_upper) 'ΉῊἨἩῆῌἬἪἭἫἮἯῄῂᾘᾙῇᾞᾟᾜᾝᾚᾛ'

c ================================
c IOTA stores
c ================================
c dks: macron breve acute grave smooth rough tilde dialytika acute_smooth grave_smooth acute_rough grave_rough tilde_smooth tilde_rough dialytika_acute dialytika_grave dialytika_tilde
c note: dialytika = dk(iunder) repurposed for iota/upsilon
c note: dialytika does not combine with breathings; tilde alone has no uppercase form
c note: macron_smooth, macron_rough, breve_smooth and breve_rough are handled as
c       explicit combining-mark rules in the IOTA block below, for the same
c       Unicode/alignment reason explained in the ALPHA stores section above.
store(iota_dks)   dk(macron) dk(breve) dk(acute) dk(grave) dk(smooth) dk(rough) dk(tilde) dk(iunder) dk(acute_smooth) dk(grave_smooth) dk(acute_rough) dk(grave_rough) dk(tilde_smooth) dk(tilde_rough) dk(iunder_acute) dk(iunder_grave) dk(iunder_tilde)
store(iota_lower) 'ῑῐίὶἰἱῖϊἴἲἵἳἶἷΐῒῗ'
store(iota_upper) 'ῙῘΊῚἸἹῖΪἼἺἽἻἾἿΊῚΪ'

c ================================
c UPSILON stores
c ================================
c dks: macron breve acute grave smooth rough tilde dialytika acute_smooth grave_smooth acute_rough grave_rough tilde_smooth tilde_rough dialytika_acute dialytika_grave dialytika_tilde
c note: uppercase psili forms don't exist in Unicode; lowercase used for smooth/acute_smooth/grave_smooth/tilde_smooth/tilde
c note: macron_smooth, macron_rough, breve_smooth and breve_rough are handled as
c       explicit combining-mark rules in the UPSILON block below, for the same
c       Unicode/alignment reason explained in the ALPHA stores section above.
store(upsilon_dks)   dk(macron) dk(breve) dk(acute) dk(grave) dk(smooth) dk(rough) dk(tilde) dk(iunder) dk(acute_smooth) dk(grave_smooth) dk(acute_rough) dk(grave_rough) dk(tilde_smooth) dk(tilde_rough) dk(iunder_acute) dk(iunder_grave) dk(iunder_tilde)
store(upsilon_lower) 'ῡῠύὺὐὑῦϋὔὒὕὓὖὗΰῢῧ'
store(upsilon_upper) 'ῩῨΎῪὐὙῦΫὔὒὝὛὖὟΎῪΫ'

c ================================
c OMICRON stores
c ================================
c dks: acute grave smooth rough acute_smooth grave_smooth acute_rough grave_rough
c note: omicron is always short in Attic Greek, so it never takes a macron/breve;
c       no macron/breve(+breathing) combinations exist for this vowel.
store(omicron_dks)   dk(acute) dk(grave) dk(smooth) dk(rough) dk(acute_smooth) dk(grave_smooth) dk(acute_rough) dk(grave_rough)
store(omicron_lower) 'όὸὀὁὄὂὅὃ'
store(omicron_upper) 'ΌῸὈὉὌὊὍὋ'

c ================================
c OMEGA stores
c ================================
c dks: acute grave smooth rough tilde iunder acute_smooth grave_smooth acute_rough grave_rough tilde_smooth tilde_rough iunder_acute iunder_grave iunder_smooth iunder_rough iunder_tilde iunder_tilde_smooth iunder_tilde_rough iunder_acute_smooth iunder_acute_rough iunder_grave_smooth iunder_grave_rough
c note: uppercase tilde/iunder_acute/iunder_grave/iunder_tilde have no Unicode uppercase form; lowercase chars used
c note: omega is always long in Attic Greek, so it never takes a macron/breve;
c       no macron/breve(+breathing) combinations exist for this vowel.
store(omega_dks)   dk(acute) dk(grave) dk(smooth) dk(rough) dk(tilde) dk(iunder) dk(acute_smooth) dk(grave_smooth) dk(acute_rough) dk(grave_rough) dk(tilde_smooth) dk(tilde_rough) dk(iunder_acute) dk(iunder_grave) dk(iunder_smooth) dk(iunder_rough) dk(iunder_tilde) dk(iunder_tilde_smooth) dk(iunder_tilde_rough) dk(iunder_acute_smooth) dk(iunder_acute_rough) dk(iunder_grave_smooth) dk(iunder_grave_rough)
store(omega_lower) 'ώὼὠὡῶῳὤὢὥὣὦὧῴῲᾠᾡῷᾦᾧᾤᾥᾢᾣ'
store(omega_upper) 'ΏῺὨὩῶῼὬὪὭὫὮὯῴῲᾨᾩῷᾮᾯᾬᾭᾪᾫ'

group(main) using keys

+ any(keys_lower) > index(greek_lower, 1)
+ any(keys_shift) > index(greek_upper, 1)

c --- OMEGA base output (explicit, outside generic stores) ---
+ [K_V]       > 'ω'
+ [SHIFT K_V] > 'Ω'

c SIGNS:
+ [K_?C1]          > ';'
+ [K_SLASH]        > '·'
+ [SHIFT K_COMMA]  > '«'
+ [SHIFT K_PERIOD] > '»'

c ================================
c DEADKEY ASSIGNMENTS - ABNT2
c ================================

+ [K_LBRKT]        > dk(acute)        c ´ = acute
+ [SHIFT K_LBRKT]  > dk(grave)        c ` = grave
+ [K_QUOTE]        > dk(tilde)
+ [SHIFT K_QUOTE]  > dk(tilde)
+ [K_RBRKT]        > dk(rough)        c [ and { = rough (dasia)
+ [SHIFT K_RBRKT]  > dk(rough)
+ [K_BKSLASH]      > dk(smooth)       c ] and } = smooth (psili)
+ [SHIFT K_BKSLASH] > dk(smooth)
+ [K_HYPHEN]       > dk(macron)
+ [SHIFT K_HYPHEN] > dk(breve)
+ [K_COLON]        > dk(iunder)
+ [SHIFT K_COLON]  > dk(iunder)

c ================================
c DEADKEY NORMALIZATION
c ================================

c --- ACUTE + BREATHING ---
c [ / { = rough, ] / } = smooth (both shift-states of each bracket pair give
c the same breathing, since breathing doesn't distinguish shift state).
dk(acute) + [K_RBRKT]        > dk(acute_rough)
dk(acute) + [SHIFT K_RBRKT]  > dk(acute_rough)
dk(acute) + [K_BKSLASH]      > dk(acute_smooth)
dk(acute) + [SHIFT K_BKSLASH] > dk(acute_smooth)
dk(rough)  + [K_LBRKT]      > dk(acute_rough)
dk(smooth) + [K_LBRKT]      > dk(acute_smooth)

c --- GRAVE + BREATHING ---
dk(grave) + [K_RBRKT]        > dk(grave_rough)
dk(grave) + [SHIFT K_RBRKT]  > dk(grave_rough)
dk(grave) + [K_BKSLASH]      > dk(grave_smooth)
dk(grave) + [SHIFT K_BKSLASH] > dk(grave_smooth)
dk(rough)  + [SHIFT K_LBRKT] > dk(grave_rough)
dk(smooth) + [SHIFT K_LBRKT] > dk(grave_smooth)

c --- TILDE + BREATHING ---
dk(tilde) + [K_RBRKT]        > dk(tilde_rough)
dk(tilde) + [SHIFT K_RBRKT]  > dk(tilde_rough)
dk(tilde) + [K_BKSLASH]      > dk(tilde_smooth)
dk(tilde) + [SHIFT K_BKSLASH] > dk(tilde_smooth)
dk(rough)  + [K_QUOTE]      > dk(tilde_rough)
dk(smooth) + [K_QUOTE]      > dk(tilde_smooth)

c --- MACRON + BREATHING ---
c Only meaningful for α, ι, υ — the vowels with variable quantity in Attic Greek.
c ε, η, ο, ω are inherently short/long respectively and never take a macron
c (see the "note" lines in the EPSILON/ETA/OMICRON/OMEGA stores above), so no
c vowel rule is ever written for dk(macron_smooth)/dk(macron_rough) on those
c letters. Both input orders are supported, mirroring ACUTE/GRAVE/TILDE above:
c macron-then-breathing-key, or breathing-then-macron-key.
dk(macron) + [K_RBRKT]        > dk(macron_rough)
dk(macron) + [SHIFT K_RBRKT]  > dk(macron_rough)
dk(macron) + [K_BKSLASH]      > dk(macron_smooth)
dk(macron) + [SHIFT K_BKSLASH] > dk(macron_smooth)
dk(rough)  + [K_HYPHEN]       > dk(macron_rough)
dk(smooth) + [K_HYPHEN]       > dk(macron_smooth)

c --- BREVE + BREATHING ---
c Only meaningful for α, ι, υ, for the same reason as MACRON above.
dk(breve) + [K_RBRKT]         > dk(breve_rough)
dk(breve) + [SHIFT K_RBRKT]   > dk(breve_rough)
dk(breve) + [K_BKSLASH]       > dk(breve_smooth)
dk(breve) + [SHIFT K_BKSLASH] > dk(breve_smooth)
dk(rough)  + [SHIFT K_HYPHEN] > dk(breve_rough)
dk(smooth) + [SHIFT K_HYPHEN] > dk(breve_smooth)

c --- IUNDER + ACCENT/BREATHING ---
dk(iunder) + [K_LBRKT]        > dk(iunder_acute)
dk(iunder) + [SHIFT K_LBRKT]  > dk(iunder_grave)
dk(iunder) + [K_RBRKT]        > dk(iunder_rough)
dk(iunder) + [SHIFT K_RBRKT]  > dk(iunder_rough)
dk(iunder) + [K_BKSLASH]      > dk(iunder_smooth)
dk(iunder) + [SHIFT K_BKSLASH] > dk(iunder_smooth)
dk(iunder) + [K_QUOTE]        > dk(iunder_tilde)
dk(acute)  + [K_COLON]        > dk(iunder_acute)
dk(grave)  + [K_COLON]        > dk(iunder_grave)
dk(rough)  + [K_COLON]        > dk(iunder_rough)
dk(smooth) + [K_COLON]        > dk(iunder_smooth)
dk(tilde)  + [K_COLON]        > dk(iunder_tilde)

c --- TRIPLES: iunder_X + breathing ---
dk(iunder_acute) + [K_RBRKT]        > dk(iunder_acute_rough)
dk(iunder_acute) + [SHIFT K_RBRKT]  > dk(iunder_acute_rough)
dk(iunder_acute) + [K_BKSLASH]      > dk(iunder_acute_smooth)
dk(iunder_acute) + [SHIFT K_BKSLASH] > dk(iunder_acute_smooth)
dk(iunder_grave) + [K_RBRKT]        > dk(iunder_grave_rough)
dk(iunder_grave) + [SHIFT K_RBRKT]  > dk(iunder_grave_rough)
dk(iunder_grave) + [K_BKSLASH]      > dk(iunder_grave_smooth)
dk(iunder_grave) + [SHIFT K_BKSLASH] > dk(iunder_grave_smooth)
dk(iunder_tilde) + [K_RBRKT]        > dk(iunder_tilde_rough)
dk(iunder_tilde) + [SHIFT K_RBRKT]  > dk(iunder_tilde_rough)
dk(iunder_tilde) + [K_BKSLASH]      > dk(iunder_tilde_smooth)
dk(iunder_tilde) + [SHIFT K_BKSLASH] > dk(iunder_tilde_smooth)

c --- TRIPLES: iunder_X + accent (breathing first) ---
dk(iunder_rough)  + [K_LBRKT]        > dk(iunder_acute_rough)
dk(iunder_rough)  + [SHIFT K_LBRKT]  > dk(iunder_grave_rough)
dk(iunder_rough)  + [K_QUOTE]        > dk(iunder_tilde_rough)
dk(iunder_smooth) + [K_LBRKT]        > dk(iunder_acute_smooth)
dk(iunder_smooth) + [SHIFT K_LBRKT]  > dk(iunder_grave_smooth)
dk(iunder_smooth) + [K_QUOTE]        > dk(iunder_tilde_smooth)

c --- TRIPLES: accent+breathing pair + iunder ---
dk(acute_rough)  + [K_COLON]        > dk(iunder_acute_rough)
dk(acute_smooth) + [K_COLON]        > dk(iunder_acute_smooth)
dk(grave_rough)  + [K_COLON]        > dk(iunder_grave_rough)
dk(grave_smooth) + [K_COLON]        > dk(iunder_grave_smooth)
dk(tilde_rough)  + [K_COLON]        > dk(iunder_tilde_rough)
dk(tilde_smooth) + [K_COLON]        > dk(iunder_tilde_smooth)

c ================================
c VOWEL RULES
c ================================

c --- ALPHA ---
c --- ALPHA: expanded (any/index over deadkeys unsupported for web/touch) ---
dk(macron) + [K_A]       > 'ᾱ'
dk(macron) + [SHIFT K_A] > 'Ᾱ'
dk(breve) + [K_A]       > 'ᾰ'
dk(breve) + [SHIFT K_A] > 'Ᾰ'
dk(acute) + [K_A]       > 'ά'
dk(acute) + [SHIFT K_A] > 'Ά'
dk(grave) + [K_A]       > 'ὰ'
dk(grave) + [SHIFT K_A] > 'Ὰ'
dk(smooth) + [K_A]       > 'ἀ'
dk(smooth) + [SHIFT K_A] > 'Ἀ'
dk(rough) + [K_A]       > 'ἁ'
dk(rough) + [SHIFT K_A] > 'Ἁ'
dk(tilde) + [K_A]       > 'ᾶ'
dk(tilde) + [SHIFT K_A] > 'ᾶ'
dk(iunder) + [K_A]       > 'ᾳ'
dk(iunder) + [SHIFT K_A] > 'ᾼ'
dk(acute_smooth) + [K_A]       > 'ἄ'
dk(acute_smooth) + [SHIFT K_A] > 'Ἄ'
dk(grave_smooth) + [K_A]       > 'ἂ'
dk(grave_smooth) + [SHIFT K_A] > 'Ἂ'
dk(acute_rough) + [K_A]       > 'ἅ'
dk(acute_rough) + [SHIFT K_A] > 'Ἅ'
dk(grave_rough) + [K_A]       > 'ἃ'
dk(grave_rough) + [SHIFT K_A] > 'Ἃ'
dk(tilde_smooth) + [K_A]       > 'ἆ'
dk(tilde_smooth) + [SHIFT K_A] > 'Ἆ'
dk(tilde_rough) + [K_A]       > 'ἇ'
dk(tilde_rough) + [SHIFT K_A] > 'Ἇ'
dk(iunder_acute) + [K_A]       > 'ᾴ'
dk(iunder_acute) + [SHIFT K_A] > 'ᾴ'
dk(iunder_grave) + [K_A]       > 'ᾲ'
dk(iunder_grave) + [SHIFT K_A] > 'ᾲ'
dk(iunder_smooth) + [K_A]       > 'ᾀ'
dk(iunder_smooth) + [SHIFT K_A] > 'ᾈ'
dk(iunder_rough) + [K_A]       > 'ᾁ'
dk(iunder_rough) + [SHIFT K_A] > 'ᾉ'
dk(iunder_tilde) + [K_A]       > 'ᾷ'
dk(iunder_tilde) + [SHIFT K_A] > 'ᾷ'
dk(iunder_tilde_smooth) + [K_A]       > 'ᾆ'
dk(iunder_tilde_smooth) + [SHIFT K_A] > 'ᾎ'
dk(iunder_tilde_rough) + [K_A]       > 'ᾇ'
dk(iunder_tilde_rough) + [SHIFT K_A] > 'ᾏ'
dk(iunder_acute_smooth) + [K_A]       > 'ᾄ'
dk(iunder_acute_smooth) + [SHIFT K_A] > 'ᾌ'
dk(iunder_acute_rough) + [K_A]       > 'ᾅ'
dk(iunder_acute_rough) + [SHIFT K_A] > 'ᾍ'
dk(iunder_grave_smooth) + [K_A]       > 'ᾂ'
dk(iunder_grave_smooth) + [SHIFT K_A] > 'ᾊ'
dk(iunder_grave_rough) + [K_A]       > 'ᾃ'
dk(iunder_grave_rough) + [SHIFT K_A] > 'ᾋ'

c --- ALPHA: macron/breve + breathing ---
c No precomposed Unicode codepoint exists for "long/short alpha + breathing", so
c output is built from the precomposed breathing form (ἀ/ἁ/Ἀ/Ἁ) plus a combining
c macron (U+0304) or combining breve (U+0306) stacked on top — the same combining
c marks that ᾱ (U+1FB1) and ᾰ (U+1FB0) canonically decompose to.
dk(macron_smooth) + [K_A]       > 'ἀ' U+0304
dk(macron_smooth) + [SHIFT K_A] > 'Ἀ' U+0304
dk(macron_rough)  + [K_A]       > 'ἁ' U+0304
dk(macron_rough)  + [SHIFT K_A] > 'Ἁ' U+0304
dk(breve_smooth)  + [K_A]       > 'ἀ' U+0306
dk(breve_smooth)  + [SHIFT K_A] > 'Ἀ' U+0306
dk(breve_rough)   + [K_A]       > 'ἁ' U+0306
dk(breve_rough)   + [SHIFT K_A] > 'Ἁ' U+0306

c --- EPSILON ---
c --- EPS: expanded (any/index over deadkeys unsupported for web/touch) ---
dk(acute) + [K_E]       > 'έ'
dk(acute) + [SHIFT K_E] > 'Έ'
dk(grave) + [K_E]       > 'ὲ'
dk(grave) + [SHIFT K_E] > 'Ὲ'
dk(smooth) + [K_E]       > 'ἐ'
dk(smooth) + [SHIFT K_E] > 'Ἐ'
dk(rough) + [K_E]       > 'ἑ'
dk(rough) + [SHIFT K_E] > 'Ἑ'
dk(acute_smooth) + [K_E]       > 'ἔ'
dk(acute_smooth) + [SHIFT K_E] > 'Ἔ'
dk(grave_smooth) + [K_E]       > 'ἒ'
dk(grave_smooth) + [SHIFT K_E] > 'Ἒ'
dk(acute_rough) + [K_E]       > 'ἕ'
dk(acute_rough) + [SHIFT K_E] > 'Ἕ'
dk(grave_rough) + [K_E]       > 'ἓ'
dk(grave_rough) + [SHIFT K_E] > 'Ἓ'

c --- ETA ---
c --- ETA: expanded (any/index over deadkeys unsupported for web/touch) ---
dk(acute) + [K_H]       > 'ή'
dk(acute) + [SHIFT K_H] > 'Ή'
dk(grave) + [K_H]       > 'ὴ'
dk(grave) + [SHIFT K_H] > 'Ὴ'
dk(smooth) + [K_H]       > 'ἠ'
dk(smooth) + [SHIFT K_H] > 'Ἠ'
dk(rough) + [K_H]       > 'ἡ'
dk(rough) + [SHIFT K_H] > 'Ἡ'
dk(tilde) + [K_H]       > 'ῆ'
dk(tilde) + [SHIFT K_H] > 'ῆ'
dk(iunder) + [K_H]       > 'ῃ'
dk(iunder) + [SHIFT K_H] > 'ῌ'
dk(acute_smooth) + [K_H]       > 'ἤ'
dk(acute_smooth) + [SHIFT K_H] > 'Ἤ'
dk(grave_smooth) + [K_H]       > 'ἢ'
dk(grave_smooth) + [SHIFT K_H] > 'Ἢ'
dk(acute_rough) + [K_H]       > 'ἥ'
dk(acute_rough) + [SHIFT K_H] > 'Ἥ'
dk(grave_rough) + [K_H]       > 'ἣ'
dk(grave_rough) + [SHIFT K_H] > 'Ἣ'
dk(tilde_smooth) + [K_H]       > 'ἦ'
dk(tilde_smooth) + [SHIFT K_H] > 'Ἦ'
