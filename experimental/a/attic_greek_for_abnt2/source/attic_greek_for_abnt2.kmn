dk(iunder_tilde) + [K_I]       > 'ῗ'
dk(iunder_tilde) + [SHIFT K_I] > 'Ϊ'

c --- IOTA: macron/breve + breathing ---
c Same rationale as ALPHA above: ἰ/ἱ/Ἰ/Ἱ plus a combining macron/breve.
dk(macron_smooth) + [K_I]       > 'ἰ' U+0304
dk(macron_smooth) + [SHIFT K_I] > 'Ἰ' U+0304
dk(macron_rough)  + [K_I]       > 'ἱ' U+0304
dk(macron_rough)  + [SHIFT K_I] > 'Ἱ' U+0304
