any(t) any(h) any(two_u) 'o' + any(w) > index(t, 1) index(h, 2) index(two_u, 3)'ơ'
any(t) any(h) any(two_u) 'O' + any(w) > index(t, 1) index(h, 2) index(two_u, 3)'Ơ'
