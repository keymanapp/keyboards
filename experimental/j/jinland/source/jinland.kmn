any(two_u) 'Ơ' + any(punctuation) > index(two_uw, 1) 'Ơ' index(punctuation, 3)

any(two_u) 'ơ' + any(s) > index(two_uw, 1) 'ớ'
any(two_u) 'Ơ' + any(s) > index(two_uw, 1) 'Ớ'
