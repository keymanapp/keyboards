U+0328 + any(x) > U+0328 index(x, 2)
U+0328 dk(n) + any(x) > U+0328 index(x, 3)

any(qq) 'ú' + any(vowel) > index(qq, 1) 'u' index(vowel_sac, 3)
any(qq) 'ù' + any(vowel) > index(qq, 1) 'u' index(vowel_huyen, 3)
any(qq) 'ủ' + any(vowel) > index(qq, 1) 'u' index(vowel_hoi, 3)
