any(two_u) 'o' any(two_u) + any(low_sfrxj) > index(two_u, 1) index(low_o_tones, 4) index(two_u, 3)
any(two_u) 'o' any(two_u) + any(upper_sfrxj) > index(two_u, 1) index(low_o_tones, 4) index(two_u, 3)
any(two_u) 'O' any(two_u) + any(low_sfrxj) > index(two_u, 1) index(upper_o_tones, 4) index(two_u, 3)
