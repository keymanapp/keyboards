+ [SHIFT K_1] > '!'
c + [SHIFT K_BKQUOTE] > '̃'
+ [SHIFT K_BKSLASH] > '|'
+ [SHIFT K_RBRKT] > '}'
+ [SHIFT K_LBRKT] > '{'
+ [SHIFT K_P] > 'P'
