+ [K_W] > 'w'
+ [K_Q] > 'q'
+ [K_SLASH] > '/'
+ [K_PERIOD] > '.'
+ [K_COMMA] > ','
+ [K_M] > 'm'
+ [K_N] > 'n'
+ [K_B] > 'b'
+ [K_V] > 'v'
+ [K_C] > 'c'
+ [K_X] > 'x'
+ [K_Z] > 'z'
+ [K_QUOTE] > U+0027
+ [K_COLON] > ';'
+ [K_L] > 'l'
+ [K_K] > 'k'
+ [K_J] > 'j'
+ [K_H] > 'h'
+ [K_G] > 'g'
+ [K_F] > 'f'
+ [K_D] > 'd'
+ [K_S] > 's'
+ [K_A] > 'a'
+ [K_BKQUOTE] > U+0323

c ====================== Reorder rules ======================

c produce backquote
U+0323 + '`' > '`'

c reorder to dotted, then tilde
U+0303 + '`' > U+0323 U+0303

c ====================== Diacritics rule ======================

c validate typing dot first
c U+0323 + any(base_of_dotted) > index(base_of_dotted,2) U+0323 c deadkey(dotwait)
c U+0323 + any(base_of_dotted) > nul

c ====================== Backspace rule ======================

c backspace removes diacritic and the base letter
store(alphabet) 'a'..'z' 'A'..'Z'
store(diacritic) U+0323 U+0303 
any(alphabet) any(diacritic) any(diacritic) + [K_BKSP] > nul
any(alphabet) any(diacritic) + [K_BKSP] > nul
any(diacritic) any(alphabet) + [K_BKSP] > nul

c backspace removes characters c,s,z + h
c any(digraph_char) + any(hchar) > index(digraph_char, 1) index(hchar, 2) dk(h_combination)
c dk(h_combination) + any(alphabet) > index(alphabet, 2)
c any(digraph_char) any(hchar) dk(h_combination) + [K_BKSP] > nul

c ====================== Character + h/H rule ======================
c turn decomposed to composed characters (store(base) + h)
store(hchar) 'hH'
store(base) 'dDgGjJkKlLmMnNpPrRtT'

any(base) + any(hchar) > index(base, 1) index(hchar, 2) dk(composing_char)
dk(composing_char) + any(alphabet) > index(alphabet, 2)
any(base) any(hchar) dk(composing_char) + [K_BKSP] > nul

any(base_of_dotted) U+0323 + any(hchar) > index(base_of_dotted, 1) U+0323 index(hchar, 3) dk(composed_dotted)
dk(composed_dotted) + any(alphabet) > index(alphabet, 2)
any(base_of_dotted) U+0323 any(hchar) dk(composed_dotted) + [K_BKSP] > nul

c ====================== Caron ======================

store(base_of_caron) 'cCjJsSzZ'

any(base_of_caron) + '^' > index(base_of_caron, 1) U+030C 

c ====================== Dotted + Tilde ======================

store(base_of_dotted_tilde) 'aAeEiIoOuU' U+0323

any(base_of_dotted_tilde) + '~' > index(base_of_dotted_tilde, 1) U+0303

c ====================== Dotted ======================

store(base_of_dotted) "aAcCdDeEiIjJlLoOrRsStTuUzZ"

any(base_of_dotted) + '`' > index(base_of_dotted, 1) U+0323 c deadkey(dotwait) c dotwait is special for the caracter d (see below)

c ====================== Dotted + Caron ======================

store(base_of_dotted_caron) 'jJ' U+0323

any(base_of_dotted_caron) + '^' > index(base_of_dotted_caron, 1) U+030C

c ====================== Tilde ======================

store(base_of_tilde) 'aAeEiIoOuU' U+0303

any(base_of_tilde) + '`' > index(base_of_tilde, 1) U+0323

c prevent typing dot before the dotted letter
c U+0323 + any(base_of_dotted) > index(base_of_dotted, 2) U+0323

c Double tap space to produce a full stop or period

c write a rule: d followed by anything but h loses its dot
store(allkeys_except_h) 'abcdefgijklmnopqrstuvwxyzABCDEFGIJKLMNOPQRSTUVWXYZ'

c 'd' U+0323 deadkey(dotwait) + any(allkeys_except_h) > 'd' index(allkeys_except_h,4)

c touch keys; d = dot; a = tilde
+ [T_a_d] > 'a' U+0323
+ [T_a_t] > 'a' U+0303
+ [T_a_d_t] > 'a' U+0323 U+0303
+ [T_e_d] > 'e' U+0323
+ [T_e_t] > 'e' U+0303
+ [T_e_d_t] > 'e' U+0323 U+0303
+ [T_i_d] > 'i' U+0323
+ [T_i_t] > 'i' U+0303
+ [T_i_d_t] > 'i' U+0323 U+0303
+ [T_o_d] > 'o' U+0323
+ [T_o_t] > 'o' U+0303
+ [T_o_d_t] > 'o' U+0323 U+0303
+ [T_u_d] > 'u' U+0323
+ [T_u_t] > 'u' U+0303
+ [T_u_d_t] > 'u' U+0323 U+0303
+ [T_c_d] > 'c' U+0323
+ [T_d_d] > 'd' U+0323
+ [T_j_d] > 'j' U+0323
+ [T_l_d] > 'l' U+0323
+ [T_r_d] > 'r' U+0323
+ [T_s_d] > 's' U+0323
+ [T_t_d] > 't' U+0323
+ [T_z_d] > 'z' U+0323
c + [T_a_d_cap] > 'A' U+0323
