+ [RALT SHIFT K_QUOTE] > U+00B5

+ [K_OE2] > U+003C
+ [SHIFT K_OE2] > U+003E
+ [RALT K_OE2] > U+00AB
+ [SHIFT RALT K_OE2] > U+00BB


group(nfc)

store(baseAcuteK) "aeiouAEIOUlLmMnNrR"
store(baseAcuteU)  U+00E1 U+00E9 U+00ED U+00F3 U+00FA U+00C1 U+00C9 U+00CD U+00D3 U+00DA U+013A U+0139 U+1E3F U+1E3E U+0144 U+0143 U+0155 U+0154
any(baseAcuteK) U+0301 > index(baseAcuteU,1)

store(baseGraveK) "aeiouAEIOUnN"
store(baseGraveU) U+00E0 U+00E8 U+00EC U+00F2 U+00F9 U+00C0 U+00C8 U+00CC U+00D2 U+00D9 U+01F9 U+01F8
any(baseGraveK) U+0300 > index(baseGraveU,1)

store(baseMacronK) "aeiouAEIOU"
store(baseMacronU) U+0101 U+0113 U+012B U+014D U+016B U+0100 U+0112 U+012A U+014C U+016A 
any(baseMacronK) U+0304 > index(baseMacronU,1)

store(baseTildeK) "aeiouAEIOU"
store(baseTildeU) U+00E3 U+1EBD U+0129 U+00F5 U+0169 U+00C3 U+1EBC U+0128 U+00D5 U+0168 
any(baseTildeK) U+0303 > index(baseTildeU,1)

store(baseTildeMacronK) "Õõ"
store(baseTildeMacronU) U+022C U+022D
any(baseTildeMacronK) U+0304 > index(baseTildeMacronU,1)

store(baseTildeAcuteK) "ÕõŨũ"
store(baseTildeAcuteU) U+1E4C U+1E4D U+1E78 U+1E79
any(baseTildeAcuteK) U+0301 > index(baseTildeAcuteU,1)
