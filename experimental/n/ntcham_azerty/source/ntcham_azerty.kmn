store(&VERSION) '17.0'
store(&NAME) 'Ntcham (AZERTY)'
store(&COPYRIGHT) '© Wycliffe Togo'
store(&BITMAP) 'ntcham_azerty.ico'
store(&LAYOUTFILE) 'ntcham_azerty.keyman-touch-layout'
store(&KEYBOARDVERSION) '0.6.0'
store(&TARGETS) 'any'
store(&VISUALKEYBOARD) 'ntcham_azerty.kvks'
store(&CasedKeys) [K_A]..[K_Z] [K_0]..[K_9] [K_HYPHEN] [K_EQUAL] [K_LBRKT] [K_RBRKT] [K_BKSLASH] [K_QUOTE] [K_COMMA] [K_PERIOD] [K_COLON]
c Technically, [K_SLASH] should be in the above list, but I'm choosing not to add it to avoid confusion.  

begin Unicode > use(main)

store(base-mark) "abeiouABEIOUlLmMnNrR" U+0251 U+0269 U+014B U+0254 U+028B U+2C6D U+0196 U+0186 U+01B2 U+014A
store(base-vowel-mark) "aeiouAEIOU" U+0251 U+0269 U+0254 U+028B U+2C6D U+0196 U+0186 U+01B2




store(blmnrOuMacron) "blmnrBLMNR" U+0254 U+0186
store(blmrOuGrave) "blmrBLMR" U+0254 U+0186


c Special characters
store(specialKBase) [K_Q] [K_I] [K_N] [K_O] [K_U] [SHIFT K_Q] [SHIFT K_I] [SHIFT K_O] [SHIFT K_U] [SHIFT K_N]
store(specialK) [RALT K_Q] [RALT K_I] [RALT K_N] [RALT K_O] [RALT K_U] [SHIFT RALT K_Q] [SHIFT RALT K_I] [SHIFT RALT K_O] [SHIFT RALT K_U] [SHIFT RALT K_N]
store(specialU) U+0251     U+0269     U+014B     U+0254     U+028B     U+2C6D           U+0196           U+0186           U+01B2           U+014A


group(main) using keys

c ɑɩŋɔʋ
+ any(specialK)        > index(specialU,1)
U+003B + any(specialKBase) >  index(specialU,2)

c acute aeiou b l m n ɑɩŋɔʋ
any(base-mark) + [K_LBRKT] > context U+0301 use(nfc)
any(base-mark) + [SHIFT K_LBRKT] > context U+0301 use(nfc)


c macrons aeiou blmn ɑɩŋɔʋ
any(base-mark) + [K_RBRKT] > context U+0304 use(nfc)
any(base-mark) + [SHIFT K_RBRKT] > context U+0304 use(nfc)

c grave
any(base-mark) + [K_BKSLASH] > context U+0300 use(nfc)
any(base-mark) + [SHIFT K_BKSLASH] > context U+0300 use(nfc)

c tilde aeiou ɔ
any(base-vowel-mark) + [K_BKQUOTE] > context U+0303 use(nfc)
any(base-vowel-mark) + [SHIFT K_BKQUOTE] > context U+0303 use(nfc)

any(base-vowel-mark) U+0303 + [K_BKSLASH] > context U+0300 use(nfc)
any(base-vowel-mark) U+0303 + [SHIFT K_BKSLASH] > context U+0300 use(nfc)
any(base-vowel-mark) U+0303 + [K_LBRKT] > context U+0301 use(nfc)
any(base-vowel-mark) U+0303 + [SHIFT K_LBRKT] > context U+0301 use(nfc)
any(base-vowel-mark) U+0303 + [K_RBRKT] > context U+0304 use(nfc)
any(base-vowel-mark) U+0303 + [SHIFT K_RBRKT] > context U+0304 use(nfc)

any(baseTildeU) + [K_BKSLASH] > context U+0300 use(nfc)
any(baseTildeU) + [SHIFT K_BKSLASH] > context U+0300 use(nfc)
any(baseTildeU) + [K_LBRKT] > context U+0301 use(nfc)
any(baseTildeU) + [SHIFT K_LBRKT] > context U+0301 use(nfc)
any(baseTildeU) + [K_RBRKT] > context U+0304 use(nfc)
any(baseTildeU) + [SHIFT K_RBRKT] > context U+0304 use(nfc)

+ [K_0] > U+00E0
