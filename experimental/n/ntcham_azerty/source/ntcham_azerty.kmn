store(&VERSION) '17.0'
store(&NAME) 'Ntcham (AZERTY)'
store(&COPYRIGHT) '© Wycliffe Togo'
store(&BITMAP) 'ntcham_azerty.ico'
store(&LAYOUTFILE) 'ntcham_azerty.keyman-touch-layout'
store(&KEYBOARDVERSION) '0.6.0'
store(&TARGETS) 'any'
store(&VISUALKEYBOARD) 'ntcham_azerty.kvks'
store(&CasedKeys) [K_A]..[K_Z] [K_0]..[K_9] [K_HYPHEN] [K_EQUAL] [K_LBRKT] [K_RBRKT] [K_BKSLASH] [K_QUOTE] [K_COMMA] [K_PERIOD] [K_COLON]
c Technically, [K_SLASH] should be in the above list, but I'm choosing not to add it to avoid confusion.  

begin Unicode > use(main)

c store(base)      "aAeEiIoOuUbBmMnN"

store(baseAcuteK) "aeiouAEIOUlLmMnNrR"
store(baseAcuteU)  U+00E1 U+00E9 U+00ED U+00F3 U+00FA U+00C1 U+00C9 U+00CD U+00D3 U+00DA U+013A U+0139 U+1E3F U+1E3E U+0144 U+0143 U+0155 U+0154

store(baseGraveK) "aeiouAEIOUnN"
store(baseGraveU) U+00E0 U+00E8 U+00EC U+00F2 U+00F9 U+00C0 U+00C8 U+00CC U+00D2 U+00D9 U+01F9 U+01F8

store(baseMacronK) "aeiouAEIOU"
store(baseMacronU) U+0101 U+0113 U+012B U+014D U+016B U+0100 U+0112 U+012A U+014C U+016A 

store(blmnrOuMacron) "blmnrBLMNR" U+0254 U+0186
store(blmrOuGrave) "blmrBLMR" U+0254 U+0186

group(main) using keys

c eng and open o
U+003B + [K_N] > U+014b
U+003B + [SHIFT K_N] > U+014a
U+003B + [K_O] > U+0254
U+003B + [SHIFT K_O] > U+0186

c acute aeiou ɔ b l m n
any(baseAcuteK) + [K_LBRKT] > index(baseAcuteU,1)
any(baseAcuteK) + [SHIFT K_LBRKT] > index(baseAcuteU,1)
U+0062 + [K_LBRKT] > context U+0301
U+0042 + [K_LBRKT] > context U+0301
U+0062 + [SHIFT K_LBRKT] > context U+0301
U+0042 + [SHIFT K_LBRKT] > context U+0301
U+0254 + [K_LBRKT] > context U+0301
U+0186 + [K_LBRKT] > context U+0301
U+0254 + [SHIFT K_LBRKT] > context U+0301
U+0186 + [SHIFT K_LBRKT] > context U+0301

c macrons aeiou ɔ blmn
any(baseMacronK) + [K_RBRKT] > index(baseMacronU,1)
any(baseMacronK) + [SHIFT K_RBRKT] > index(baseMacronU,1)
any(blmnrOuMacron) + [K_RBRKT] > index(blmnrOuMacron,1) U+0304
any(blmnrOuMacron) + [SHIFT K_RBRKT] > index(blmnrOuMacron,1) U+0304

c grave
any(baseGraveK) + [K_BKSLASH] > index(baseGraveU,1)
any(baseGraveK) + [SHIFT K_BKSLASH] > index(baseGraveU,1)
any(blmrOuGrave) + [K_BKSLASH] > index(blmrOuGrave,1) U+0300
any(blmrOuGrave) + [SHIFT K_BKSLASH] > index(blmrOuGrave,1) U+0300

+ [K_0] > U+00E0
+ [SHIFT K_0] > U+0030
+ [RALT K_0] > U+0040

