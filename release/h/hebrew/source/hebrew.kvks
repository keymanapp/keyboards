<?xml version="1.0" encoding="utf-8"?>
<visualkeyboard>
  <header>
    <version>10.0</version>
    <kbdname>hebrew</kbdname>
    <flags>
      <displayunderlying/>
    </flags>
  </header>
  <encoding name="unicode" fontname="Arial" fontsize="-12">
    <layer shift="C">
      <key vkey="K_SPACE"> </key>
      <key vkey="K_QUOTE">״</key>
      <key vkey="K_COMMA">,</key>
      <key vkey="K_HYPHEN">ַ</key>
      <key vkey="K_PERIOD">ְ</key>
      <key vkey="K_0">◌</key>
      <key vkey="K_2">̶</key>
      <key vkey="K_3">̊</key>
      <key vkey="K_4">₪</key>
      <key vkey="K_5">‍</key>
      <key vkey="K_6">‌</key>
      <key vkey="K_7">͏</key>
      <key vkey="K_8">ֺ</key>
      <key vkey="K_COLON">;</key>
      <key vkey="K_EQUAL">•</key>
      <key vkey="K_BKSLASH">\</key>
      <key vkey="K_B">׆</key>
      <key vkey="K_C">֢</key>
      <key vkey="K_J">ױ</key>
      <key vkey="K_L">ׇ</key>
      <key vkey="K_Q">ֳ</key>
      <key vkey="K_T">ת</key>
      <key vkey="K_V">װ</key>
      <key vkey="K_Y">ײ</key>
    </layer>
    <layer shift="S">
      <key vkey="K_1">֩</key>
      <key vkey="K_3">֒</key>
      <key vkey="K_4">֯</key>
      <key vkey="K_5">ֺ</key>
      <key vkey="K_7">ֿ</key>
      <key vkey="K_0">֝</key>
      <key vkey="K_8">ֹ</key>
      <key vkey="K_COLON">ֲ</key>
      <key vkey="K_COMMA">֑</key>
      <key vkey="K_PERIOD">ֻ</key>
      <key vkey="K_SLASH">֣</key>
      <key vkey="K_2">֙</key>
      <key vkey="K_A">ע</key>
      <key vkey="K_B">֥</key>
      <key vkey="K_C">֪</key>
      <key vkey="K_D">ֻ</key>
      <key vkey="K_E">ֱ</key>
      <key vkey="K_F">ף</key>
      <key vkey="K_H">ח</key>
      <key vkey="K_I">֡</key>
      <key vkey="K_K">ך</key>
      <key vkey="K_L">ָ</key>
      <key vkey="K_M">ם</key>
      <key vkey="K_N">ן</key>
      <key vkey="K_O">֕</key>
      <key vkey="K_P">֔</key>
      <key vkey="K_Q">ָ</key>
      <key vkey="K_R">֟</key>
      <key vkey="K_S">ש</key>
      <key vkey="K_T">צ</key>
      <key vkey="K_U">֜</key>
      <key vkey="K_V">ו</key>
      <key vkey="K_W">֬</key>
      <key vkey="K_X">֤</key>
      <key vkey="K_Y">֞</key>
      <key vkey="K_Z">ׅ</key>
      <key vkey="K_6">ֹ</key>
      <key vkey="K_HYPHEN">־</key>
      <key vkey="K_LBRKT">֗</key>
      <key vkey="K_BKSLASH">֨</key>
      <key vkey="K_RBRKT">֘</key>
      <key vkey="K_BKQUOTE">֮</key>
    </layer>
    <layer shift="">
      <key vkey="K_QUOTE">׳</key>
      <key vkey="K_HYPHEN">-</key>
      <key vkey="K_PERIOD">ִ</key>
      <key vkey="K_1">ֽ</key>
      <key vkey="K_8">ׂ</key>
      <key vkey="K_9">ׁ</key>
      <key vkey="K_COLON">֦</key>
      <key vkey="K_EQUAL">ּ</key>
      <key vkey="K_LBRKT">[</key>
      <key vkey="K_BKSLASH">׀</key>
      <key vkey="K_RBRKT">]</key>
      <key vkey="K_BKQUOTE">׃</key>
      <key vkey="K_A">א</key>
      <key vkey="K_D">ד</key>
      <key vkey="K_E">ֶ</key>
      <key vkey="K_F">פ</key>
      <key vkey="K_G">ג</key>
      <key vkey="K_H">ה</key>
      <key vkey="K_K">כ</key>
      <key vkey="K_L">ל</key>
      <key vkey="K_M">מ</key>
      <key vkey="K_N">נ</key>
