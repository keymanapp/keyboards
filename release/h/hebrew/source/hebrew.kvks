      <key vkey="K_P">ֽ</key>
      <key vkey="K_Q">ק</key>
      <key vkey="K_R">ר</key>
      <key vkey="K_S">ס</key>
      <key vkey="K_T">ט</key>
      <key vkey="K_U">ֶ</key>
      <key vkey="K_V">ב</key>
      <key vkey="K_Y">י</key>
      <key vkey="K_Z">ז</key>
    </layer>
    <layer shift="A">
      <key vkey="K_HYPHEN">ֲ</key>
      <key vkey="K_PERIOD">ֵ</key>
      <key vkey="K_T">ץ</key>
    </layer>
  </encoding>
</visualkeyboard>
