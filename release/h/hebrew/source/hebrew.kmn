store(&VERSION) '10.0'
store(&NAME) 'Hebrew - My version  '
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'any'
store(&BITMAP) 'hebrew.ico'
store(&VISUALKEYBOARD) 'hebrew.kvks'
store(&LAYOUTFILE) 'hebrew.keyman-touch-layout'
store(&KMW_RTL) '1'

begin Unicode > use(main)

group(main) using keys
+ [K_SPACE] > ' '
+ [CTRL K_PERIOD] > 'ְ'
+ [SHIFT K_PERIOD] > 'ֻ'
+ [ALT K_PERIOD] > 'ֵ'
+ [ALT K_HYPHEN] > 'ֲ'
+ [ALT K_T] > 'ץ'
