<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.235.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome\welcome.htm</WelcomeFile>
    <FollowKeyboardVersion/>
  </Options>
  <Info>
    <Name URL="">Uzbek Latin 2026</Name>
    <Copyright URL="">© bitg contributors</Copyright>
    <Author URL="">bitg</Author>
    <WebSite URL="https://bitg.uz">https://bitg.uz</WebSite>
    <Description URL="">Uzbek Latin keyboard for the 2026 alphabet (ö ğ ş ç and the tutuq ʼ). The desktop layout follows the layout proposed at the Senate in September 2026; it is not an official standard.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\uzbek_latin_2026.kmx</Name>
    </File>
    <File>
      <Name>..\build\uzbek_latin_2026.js</Name>
    </File>
    <File>
      <Name>..\build\uzbek_latin_2026.kvk</Name>
    </File>
    <File>
      <Name>welcome\welcome.htm</Name>
    </File>
    <File>
      <Name>readme.htm</Name>
    </File>
    <File>
      <Name>..\LICENSE.md</Name>
    </File>
  </Files>
  <Keyboards>
    <Keyboard>
      <ID>uzbek_latin_2026</ID>
      <Languages>
        <Language ID="uz">Uzbek</Language>
      </Languages>
    </Keyboard>
  </Keyboards>
</Package>
