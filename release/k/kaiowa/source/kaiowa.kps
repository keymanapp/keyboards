  <Info>
    <Name URL="">Kaiowá</Name>
    <Copyright URL="">© Bruno Maia de Jesus - TJ</Copyright>
    <Author URL="">Bruno Maia de Jesus - TJ</Author>
    <Description URL="">Teclado para a língua kaiowá: no celular, QWERTY com uma fileira fixa de letras kaiowá (ã ẽ ĩ õ ũ ỹ g̃ ý e a glotal '); no computador, ABNT2 com teclas mortas.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\kaiowa.js</Name>
    </File>
    <File>
      <Name>..\build\kaiowa.kmx</Name>
    </File>
    <File>
      <Name>..\build\kaiowa.kvk</Name>
    </File>
