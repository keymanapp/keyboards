<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>17.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ExecuteProgram></ExecuteProgram>
    <ReadMeFile>readme.htm</ReadMeFile>
    <MSIFileName></MSIFileName>
    <MSIOptions></MSIOptions>
    <FollowKeyboardVersion/>
  </Options>
  <StartMenu>
    <Folder></Folder>
    <Items/>
  </StartMenu>
  <Info>
    <Name URL="">Kirat Rai (Unicode 16.0)</Name>
    <Version URL="">1.0.0</Version>
    <Copyright URL="">© 2026 Kirat Community &amp; Digital Initiative</Copyright>
    <Author URL="">Kirat Community</Author>
    <WebSite URL="https://github.com/keymanapp/keyboards">https://github.com/keymanapp/keyboards</WebSite>
    <Description>Official Unicode 16.0 keyboard suite for Kirat Rai script (Bantawa &amp; Kiranti languages) bundled with SIL Kanchenjunga font.</Description>
  </Info>
  <Files>
    <File>
      <Name>kirat_rai_phonetic.kmx</Name>
      <Description>Kirat Rai (Phonetic) Keyboard</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kmx</FileType>
    </File>
    <File>
      <Name>kirat_rai_phonetic.js</Name>
      <Description>Kirat Rai (Phonetic) Mobile/Web Layout</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.js</FileType>
    </File>
    <File>
      <Name>Kanchenjunga-Regular.ttf</Name>
      <Description>Font Kanchenjunga (Unicode 16.0)</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.ttf</FileType>
    </File>
    <File>
      <Name>welcome.htm</Name>
      <Description>Welcome / Visual Layout Guide</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>
    <File>
      <Name>readme.htm</Name>
      <Description>Readme &amp; Documentation</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>
  </Files>
  <Keyboards>
    <Keyboard>
      <Name>Kirat Rai (Phonetic)</Name>
      <ID>kirat_rai_phonetic</ID>
      <Version>1.0.0</Version>
      <OSKFont>Kanchenjunga-Regular.ttf</OSKFont>
      <DisplayFont>Kanchenjunga-Regular.ttf</DisplayFont>
      <Languages>
        <Language ID="bap-Krai">Bantawa (Kirat Rai script)</Language>
        <Language ID="rab-Krai">Camling (Kirat Rai script)</Language>
        <Language ID="ath-Krai">Athpariya (Kirat Rai script)</Language>
      </Languages>
    </Keyboard>
  </Keyboards>
</Package>
