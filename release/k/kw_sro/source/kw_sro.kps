<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.255.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome.htm</WelcomeFile>
    <FollowKeyboardVersion/>
  </Options>
  <Info>
    <Name URL="">KW SRO</Name>
    <Copyright URL="">© Kevin Waddell</Copyright>
    <Author URL="">Kevin Waddell</Author>
    <Description URL="">Standard Roman Orthography (SRO) for Plains, Woods, Swampy, and East Cree, and for Nakawē (Saulteaux). Type a vowel, then \ for a macron (ā), ] for a circumflex (â), [ for an acute (á), or ` for a grave (à, for Algonquin and Mohawk). For East Cree and Stoney Nakoda, u then ] gives û. Some Nakawē writers also use š and č: s then \ gives š, and c then \ gives č. Based on the FirstVoices Cree - Roman Orthography keyboard.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\kw_sro.kmx</Name>
      <Description>Keyboard KW SRO</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kmx</FileType>
    </File>
    <File>
      <Name>..\build\kw_sro.js</Name>
      <Description>Touch and web keyboard KW SRO</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.js</FileType>
    </File>
    <File>
      <Name>..\build\kw_sro.kvk</Name>
      <Description>On-screen keyboard KW SRO</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kvk</FileType>
    </File>
    <File>
      <Name>readme.htm</Name>
      <Description>Read me</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>
    <File>
      <Name>welcome.htm</Name>
      <Description>Keyboard help</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>
    <File>
      <Name>..\LICENSE.md</Name>
      <Description>Licence</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.md</FileType>
    </File>
  </Files>
  <Keyboards>
    <Keyboard>
      <Name>KW SRO</Name>
      <ID>kw_sro</ID>
      <Version>1.0</Version>
      <Languages>
        <Language ID="cr-Latn">Cree (Latin)</Language>
        <Language ID="crk-Latn">Plains Cree (Latin)</Language>
        <Language ID="csw-Latn">Swampy Cree (Latin)</Language>
        <Language ID="crl-Latn">Northern East Cree (Latin)</Language>
        <Language ID="crj-Latn">Southern East Cree (Latin)</Language>
        <Language ID="ojw">Nakawē (Saulteaux)</Language>
        <Language ID="sto">Stoney Nakoda</Language>
        <Language ID="alq">Algonquin</Language>
        <Language ID="moh">Mohawk</Language>
      </Languages>
    </Keyboard>
  </Keyboards>
  <RelatedPackages>
    <RelatedPackage ID="fv_cree_latin"/>
  </RelatedPackages>
</Package>
