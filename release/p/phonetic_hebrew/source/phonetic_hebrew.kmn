c Hebrew Letters Assigned to English Keys Most Similar in Sound or Appearence.
store(&VERSION) '10.0'
store(&NAME) 'Phonetic Hebrew'
store(&COPYRIGHT) '© Aharon Hallevi'
store(&KEYBOARDVERSION) '3.5'
store(&TARGETS) 'any'
store(&BITMAP) 'phonetic_hebrew.ico'
store(&VISUALKEYBOARD) 'phonetic_hebrew.kvks'
store(&LAYOUTFILE) 'phonetic_hebrew.keyman-touch-layout'
store(&KMW_RTL) '1'
store(&MESSAGE) 'Hebrew Letters Assigned to English Keys Most Similar in Sound or Appearence.'
store(&KMW_EMBEDJS) 'phonetic_hebrew-code.js'
store(&KMW_EMBEDCSS) 'phonetic_hebrew.css'

begin Unicode > use(main)

group(main) using keys
+ [K_SPACE] > ' '
+ [K_EQUAL] > '־'
+ [K_SLASH] > ':'
+ [K_PERIOD] > '.'
+ [K_COMMA] > ','
+ [K_BKQUOTE] > '*'
+ [K_1] > '٠'
+ [K_HYPHEN] > '0'
+ [K_0] > '9'
+ [K_9] > '8'
+ [K_8] > '7'
+ [K_7] > '6'
+ [K_6] > '5'
+ [K_5] > '4'
+ [K_4] > '3'
+ [K_3] > '2'
+ [K_2] > '1'
+ [K_T] > 'ת'
+ [K_QUOTE] > '״'
+ [K_COLON] > '׳'
+ [K_V] > 'װ'
+ [K_W] > 'ש'
+ [K_R] > 'ר'
+ [K_Q] > 'ק'
+ [K_C] > 'צ'
+ [K_X] > 'ץ'
+ [K_P] > 'פ'
+ [K_F] > 'ף'
+ [K_O] > 'ע'
+ [K_S] > 'ס'
+ [K_N] > 'נ'
+ [K_RBRKT] > 'ן'
+ [K_M] > 'מ'
+ [K_LBRKT] > 'ם'
+ [K_L] > 'ל'
+ [K_K] > 'כ'
+ [K_J] > 'ך'
+ [K_I] > 'י'
+ [K_H] > 'ח'
+ [K_Y] > 'ט'
+ [K_Z] > 'ז'
+ [K_U] > 'ו'
+ [K_E] > 'ה'
+ [K_D] > 'ד'
+ [K_G] > 'ג'
+ [K_B] > 'ב'
+ [K_A] > 'א'
