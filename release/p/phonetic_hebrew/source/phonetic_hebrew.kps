<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.253.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ExecuteProgram></ExecuteProgram>
    <ReadMeFile>readme.htm</ReadMeFile>
    <GraphicFile>Jerusalem.jpeg</GraphicFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome\welcome.htm</WelcomeFile>
    <MSIFileName></MSIFileName>
    <MSIOptions></MSIOptions>
    <FollowKeyboardVersion/>
  </Options>
  <StartMenu>
    <Folder></Folder>
    <Items/>
  </StartMenu>
  <Info>
    <Name URL="">Phonetic Hebrew</Name>
    <Copyright URL="">Copyright © Aharon Hallevi</Copyright>
    <Author URL="">Aharon Hallevi</Author>
    <Version URL=""></Version>
    <Description URL="">The Phonetic Hebrew keyboard is designed by assigning the letters to the most similar sound of the English keys or appearance to type the Hebrew language.</Description>
  </Info>
  <Files>
    <File>
      <Name>readme.htm</Name>
