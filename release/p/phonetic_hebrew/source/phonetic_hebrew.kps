      <Name>..\build\phonetic_hebrew.js</Name>
      <Description>File phonetic_hebrew.js</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.js</FileType>
    </File>
    <File>
      <Name>..\build\phonetic_hebrew.kvk</Name>
      <Description>File phonetic_hebrew.kvk</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kvk</FileType>
    </File>
    <File>
      <Name>..\build\phonetic_hebrew.kmx</Name>
      <Description>Keyboard Phonetic Hebrew</Description>
      <CopyLocation>0</CopyLocation>
