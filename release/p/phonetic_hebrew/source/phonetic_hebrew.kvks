<?xml version="1.0" encoding="utf-8"?>
<visualkeyboard>
  <header>
    <version>10.0</version>
    <kbdname>phonetic_hebrew</kbdname>
    <flags>
      <key102/>
    </flags>
  </header>
  <encoding name="unicode" fontname="Arial" fontsize="12">
    <layer shift="">
      <key vkey="K_QUOTE">״</key>
      <key vkey="K_COMMA">,</key>
      <key vkey="K_HYPHEN">0</key>
      <key vkey="K_PERIOD">.</key>
      <key vkey="K_SLASH">:</key>
      <key vkey="K_0">9</key>
      <key vkey="K_1">٠</key>
      <key vkey="K_2">1</key>
      <key vkey="K_3">2</key>
      <key vkey="K_4">3</key>
      <key vkey="K_5">4</key>
      <key vkey="K_6">5</key>
      <key vkey="K_7">6</key>
      <key vkey="K_8">7</key>
      <key vkey="K_9">8</key>
      <key vkey="K_COLON">׳</key>
      <key vkey="K_EQUAL">־</key>
      <key vkey="K_LBRKT">ם</key>
      <key vkey="K_RBRKT">ן</key>
      <key vkey="K_BKQUOTE">*</key>
      <key vkey="K_A">א</key>
      <key vkey="K_B">ב</key>
      <key vkey="K_C">צ</key>
      <key vkey="K_D">ד</key>
      <key vkey="K_E">ה</key>
      <key vkey="K_F">ף</key>
      <key vkey="K_G">ג</key>
      <key vkey="K_H">ח</key>
      <key vkey="K_I">י</key>
      <key vkey="K_J">ך</key>
      <key vkey="K_K">כ</key>
      <key vkey="K_L">ל</key>
      <key vkey="K_M">מ</key>
      <key vkey="K_N">נ</key>
      <key vkey="K_O">ע</key>
      <key vkey="K_P">פ</key>
      <key vkey="K_Q">ק</key>
      <key vkey="K_R">ר</key>
      <key vkey="K_S">ס</key>
      <key vkey="K_T">ת</key>
      <key vkey="K_U">ו</key>
      <key vkey="K_V">װ</key>
      <key vkey="K_W">ש</key>
      <key vkey="K_X">ץ</key>
      <key vkey="K_Y">ט</key>
      <key vkey="K_Z">ז</key>
      <key vkey="K_oE2">?</key>
    </layer>
  </encoding>
</visualkeyboard>
