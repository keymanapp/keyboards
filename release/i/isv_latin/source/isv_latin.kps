<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.249.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome.htm</WelcomeFile>
    <FollowKeyboardVersion/>
  </Options>
  <Info>
    <Name URL="https://github.com/radoslove/keyboard-interslavic">Medžuslovjansky (latinica)</Name>
    <Copyright URL="">© Radoslove</Copyright>
    <Author URL="">Radoslove</Author>
    <Description URL="https://github.com/radoslove/keyboard-interslavic">Interslavic Latin keyboard — standard orthography.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\isv_latin.kmx</Name>
    </File>
    <File>
      <Name>..\build\isv_latin.js</Name>
    </File>
    <File>
      <Name>..\build\isv_latin.kvk</Name>
    </File>
    <File>
      <Name>isv_latin.ico</Name>
    </File>
    <File>
      <Name>welcome.htm</Name>
    </File>
    <File>
      <Name>readme.htm</Name>
    </File>
    <File>
      <Name>..\LICENSE.md</Name>
    </File>
  </Files>
  <Keyboards>
    <Keyboard>
      <ID>isv_latin</ID>
      <Languages>
        <Language ID="isv-Latn">Interslavic</Language>
      </Languages>
    </Keyboard>
  </Keyboards>
</Package>
