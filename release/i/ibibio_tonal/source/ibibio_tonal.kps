    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome\welcome.htm</WelcomeFile>
  </Options>
  <Info>
    <Name URL="">Ibibio Tonal</Name>
    <Copyright URL="">© Solomon Usoro</Copyright>
    <Author URL="">Solomon Usoro</Author>
    <Version URL="">1.0</Version>
    <Description URL="">Types the full Ibibio alphabet (ọ ị ụ ʌ ə ñ) and all five tone marks: high, low, falling, rising and downstep, on vowels and syllabic nasals.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\ibibio_tonal.kmx</Name>
      <Description>Keyboard Ibibio Tonal</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kmx</FileType>
    </File>
    <File>
      <Name>..\build\ibibio_tonal.js</Name>
      <Description>Touch keyboard Ibibio Tonal</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.js</FileType>
    </File>
    <File>
      <Name>welcome\welcome.htm</Name>
      <Description>Welcome and help</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>
    <File>
      <Name>readme.htm</Name>
      <Description>Read me</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>
    <File>
      <Name>..\LICENSE.md</Name>
      <Description>License</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.md</FileType>
    </File>
  </Files>
  <Keyboards>
    <Keyboard>
      <Name>Ibibio Tonal</Name>
      <ID>ibibio_tonal</ID>
      <Version>1.0</Version>
      <Languages>
        <Language ID="ibb">Ibibio</Language>
      </Languages>
    </Keyboard>
  </Keyboards>
</Package>
