  <Keyboards>
    <Keyboard>
      <Name>Dega</Name>
      <ID>dega</ID>
      <Version>4.0</Version>
      <Languages>
        <Language ID="rad">Rhade</Language>
        <Language ID="kpm">Koho</Language>
        <Language ID="cmo">Central Mnong</Language>
        <Language ID="jra">Jarai</Language>
        <Language ID="bdq">Bahnar</Language>
      </Languages>
      <Examples>
        <Example ID="rad" Keys="E E d d e e" Text="Êđê" Note="Rhade" />
        <Example ID="kpm" Keys="K o w H o" Text="KơHo" Note="Koho" />
        <Example ID="cmo" Keys="M o w n o o n g" Text="Mơnông" Note="Central Mnong" />
        <Example ID="jra" Keys="J o w r a i" Text="Jơrai" Note="Jarai" />
        <Example ID="bdq" Keys="B a h n a r" Text="Bahnar" Note="Bahnar" />
