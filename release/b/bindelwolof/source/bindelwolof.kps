<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.245.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome.htm</WelcomeFile>
    <FollowKeyboardVersion/>
  </Options>
  <Info>
    <Name URL="">BindelWolof</Name>
    <Copyright URL="">© 2025-2026 Serigne Mbacké Madina Gueye</Copyright>
    <Author URL="mailto:taaluboromadina@gmail.com">Serigne Mbacké Madina Gueye (Mafaatihul Bishri)</Author>
    <Description URL="">Clavier pour écrire le wolof en Ajami (wolofal) selon la méthode Mafatihul Bishri : toutes les consonnes propres au wolof (p, c, g, ñ, ŋ et les prénasales mb, nd, nj, ng, nq), les neuf timbres vocaliques et les signes diacritiques, ainsi que les caractères nécessaires à la saisie des qasidas. Keyboard for writing Wolof in Ajami (Arabic script), following the Mafatihul Bishri orthography.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\bindelwolof.kmx</Name>
      <Description>Keyboard bindelwolof</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kmx</FileType>
    </File>
