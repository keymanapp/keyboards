<?xml version="1.0" encoding="utf-8"?>
<visualkeyboard>
  <header>
    <version>10.0</version>
    <kbdname>bindelwolof</kbdname>
    <flags>
      <key102 />
    </flags>
  </header>
  <encoding name="unicode" fontname="SenBishri" fontsize="-12">
    <layer shift="">
      <key vkey="K_TAB">Tab</key>
      <key vkey="K_oE2">&lt;</key>
      <key vkey="K_QUOTE">ٗ</key>
      <key vkey="K_COMMA">؛</key>
      <key vkey="K_HYPHEN">)</key>
      <key vkey="K_PERIOD">:</key>
      <key vkey="K_SLASH">!</key>
      <key vkey="K_0">ٚ</key>
      <key vkey="K_1">ٰ</key>
      <key vkey="K_2">ٜ</key>
      <key vkey="K_3">{</key>
      <key vkey="K_4">}</key>
      <key vkey="K_5">(</key>
      <key vkey="K_6">-</key>
      <key vkey="K_7">ۭ</key>
      <key vkey="K_8">ـ</key>
      <key vkey="K_9">دٚرْهٚمْ</key>
      <key vkey="K_COLON">م</key>
      <key vkey="K_EQUAL">=</key>
      <key vkey="K_LBRKT">ٓ</key>
      <key vkey="K_BKSLASH">ا</key>
      <key vkey="K_RBRKT">ح</key>
      <key vkey="K_BKQUOTE">ء</key>
      <key vkey="K_A">ڧ</key>
      <key vkey="K_B">ب</key>
      <key vkey="K_C">څ</key>
      <key vkey="K_D">د</key>
      <key vkey="K_E">ْ</key>
      <key vkey="K_F">ڢ</key>
      <key vkey="K_G">ݣ</key>
      <key vkey="K_H">ه</key>
      <key vkey="K_I">ِ</key>
      <key vkey="K_J">ج</key>
      <key vkey="K_K">ک</key>
      <key vkey="K_L">ل</key>
      <key vkey="K_M">،</key>
      <key vkey="K_N">ن</key>
      <key vkey="K_O">ٔ</key>
      <key vkey="K_P">ݑ</key>
      <key vkey="K_Q">َ</key>
      <key vkey="K_R">ر</key>
      <key vkey="K_S">س</key>
      <key vkey="K_T">ت</key>
      <key vkey="K_U">ُ</key>
      <key vkey="K_V">دۨ</key>
      <key vkey="K_W">جۨ</key>
      <key vkey="K_X">خ</key>
      <key vkey="K_Y">ي</key>
      <key vkey="K_Z">و</key>
    </layer>
    <layer shift="S">
      <key vkey="K_oE2">&gt;</key>
      <key vkey="K_SPACE">‏</key>
      <key vkey="K_1">1</key>
      <key vkey="K_QUOTE">%</key>
      <key vkey="K_3">3</key>
      <key vkey="K_4">4</key>
      <key vkey="K_5">5</key>
      <key vkey="K_7">7</key>
      <key vkey="K_9">9</key>
      <key vkey="K_0">0</key>
      <key vkey="K_8">8</key>
      <key vkey="K_EQUAL">+</key>
      <key vkey="K_COLON">ﷺ</key>
      <key vkey="K_COMMA">•</key>
      <key vkey="K_PERIOD">/</key>
      <key vkey="K_SLASH">؞</key>
      <key vkey="K_2">2</key>
      <key vkey="K_A">غ</key>
      <key vkey="K_B">بۢ</key>
      <key vkey="K_C">ص</key>
      <key vkey="K_D">۞</key>
      <key vkey="K_E">ّ</key>
      <key vkey="K_F">ث</key>
      <key vkey="K_G">کؐ</key>
      <key vkey="K_H">إ</key>
      <key vkey="K_I">ٍ</key>
      <key vkey="K_J">أ</key>
      <key vkey="K_K">کۨ</key>
      <key vkey="K_L">ض</key>
      <key vkey="K_M">؟</key>
      <key vkey="K_N">جؐ</key>
      <key vkey="K_O">ع</key>
      <key vkey="K_P">ظ</key>
      <key vkey="K_Q">ً</key>
      <key vkey="K_R">ز</key>
      <key vkey="K_S">ش</key>
      <key vkey="K_T">ط</key>
      <key vkey="K_U">ٌ</key>
      <key vkey="K_V">ڨ</key>
      <key vkey="K_W">ذ</key>
      <key vkey="K_X">خۨ</key>
      <key vkey="K_Y">ى</key>
      <key vkey="K_Z">ے</key>
      <key vkey="K_6">6</key>
      <key vkey="K_HYPHEN">°</key>
      <key vkey="K_LBRKT">[</key>
      <key vkey="K_BKSLASH">*</key>
      <key vkey="K_RBRKT">]</key>
      <key vkey="K_BKQUOTE">ة</key>
    </layer>
  </encoding>
</visualkeyboard>
