<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.255.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ReadMeFile>readme.htm</ReadMeFile>
    <FollowKeyboardVersion/>
    <LicenseFile>..\LICENSE.md</LicenseFile>
  </Options>
  <Info>
    <Name>BEKL (Bulgarian Enhanced)</Name>
    <Copyright>Copyright (c) 2026 BEKL contributors</Copyright>
    <Author URL="">BEKL contributors</Author>
    <Description>Bulgarian Enhanced Keyboard Layout, based on BDS and including historic Cyrillic letters.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\bekl.js</Name>
      <Description>BEKL keyboard for Keyman on iOS, Android and web</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.js</FileType>
    </File>
    <File>
      <Name>welcome.htm</Name>
      <Description>Welcome to BEKL</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>
    <File>
      <Name>readme.htm</Name>
      <Description>Package README</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>
    <File>
      <Name>..\LICENSE.md</Name>
      <Description>MIT license</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.md</FileType>
    </File>
  </Files>
  <Keyboards>
    <Keyboard>
      <Name>BEKL (Bulgarian Enhanced)</Name>
      <ID>bekl</ID>
      <Version>1.0</Version>
      <Languages>
        <Language ID="bg">Bulgarian</Language>
      </Languages>
    </Keyboard>
  </Keyboards>
</Package>
