<?xml version="1.0" encoding="utf-8"?>
<visualkeyboard>
  <header>
    <version>10.0</version>
    <kbdname>optitrans_telugu_sanskrit</kbdname>
    <flags>
      <displayunderlying/>
      <usealtgr/>
    </flags>
  </header>
  <encoding name="unicode" fontname="Noto Serif Telugu Black" fontsize="14">
    <layer shift="">
      <key vkey="K_PERIOD">.</key>
      <key vkey="K_0">౦</key>
      <key vkey="K_1">౧</key>
      <key vkey="K_2">౨</key>
