c Mon Unicode keyboard — correct character storage order for Mon script.
c Supports both standard order (type consonant first) and visual order
c (type ေ first), with smart backspace and medial reordering.
c On touch devices (phone/tablet), visual order is always forced.
c Digit mode: SHIFT+ALT+Z toggles Myanmar digits (၁၂၃) / English digits (123).
c Applies to both the main number row and the numeric keypad.

store(&VERSION)         '17.0'
store(&NAME)            'Mon K NEmin'
store(&COPYRIGHT)       'Copyright © NEmin'
store(&KEYBOARDVERSION) '1.5.5'
store(&TARGETS)         'any'
c store(&VISUALKEYBOARD)  'mon_k_nemin.kvk'
store(&MESSAGE)         'A Unicode keyboard for the Mon language — easy to type, correct character order (mnw).'
c store(&BITMAP)          'mon_k_nemin.ico'
c store(&LAYOUTFILE)      'mon_k_nemin.keyman-touch-layout'
store(&BITMAP) 'mon_k_nemin.ico'
store(&VISUALKEYBOARD) 'mon_k_nemin.kvks'
store(&LAYOUTFILE) 'mon_k_nemin.keyman-touch-layout'

begin Unicode > use(main)

store(opt_e_mode) '1'
store(opt_num_mode) '1'

store(baseK)    'qwertyuiop' \
                '[]'         \
                'zxcvbn`'    \
                'QWOP{AKL:Z' \
                'XCVBNM!~'   \
                '\U.'

store(baseU)    U+1006 U+1010 U+1014 U+1019 U+1021 U+1015 U+1000 U+105A U+101E U+1005 \
                U+101F U+1029 \
                U+1016 U+1011 U+1001 U+101C U+1018 U+100A U+105D \
                U+105B U+101D U+103F U+100F U+1028 U+1017 U+1012 U+1013 U+1002 U+1007 \
                U+100C U+1003 U+1020 U+101A U+1009 U+1023 U+100D U+100E \
                U+105C U+1025 U+1037


store(numK) '1234567890'
store(numU) U+1041 U+1042 U+1043 U+1044 U+1045 \
            U+1046 U+1047 U+1048 U+1049 U+1040

store(vowelEK) 'a'
store(vowelEU) U+1031
store(filler)  U+200B
store(asatK)   'f'
store(asatU)   U+103A
store(stackK)  'F'
store(stackU)  U+1039

store(mediaK) 'sjSGRYE'
store(mediaU) U+103B U+103C U+103E U+103D U+105F U+1060 U+105E

store(mediaNoWK) 'sjSRYE'
store(mediaNoWU) U+103B U+103C U+103E U+105F U+1060 U+105E

store(yDiaK) 's'
store(yDiaU) U+103B
store(rDiaK) 'j'
store(rDiaU) U+103C
store(hDiaK) 'S'
store(hDiaU) U+103E
store(wDiaK) 'G'
store(wDiaU) U+103D
store(mDiaK) 'R'
store(mDiaU) U+105F
store(laMedK) 'Y'
store(laMedU) U+1060
store(nDiaK) 'E'
store(nDiaU) U+105E

store(aftereK) 'gmh;'
store(aftereU) U+102B U+102C U+1034 U+1038

store(udia1K) 'dDT'
store(udia1U) U+102D U+102E U+1033

store(udia2K) 'JH'
store(udia2U) U+1032 U+1036

store(ldiaK) 'kl'
store(ldiaU) U+102F U+1030


store(consU) U+1000 U+1001 U+1002 U+1003 U+1004 U+1005 U+1006 U+1007 U+1008 \
             U+1009 U+100A \
             U+100B U+100C U+100D U+100E U+100F U+1010 U+1011 U+1012 U+1013 \
             U+1014 U+1015 U+1016 U+1017 U+1018 U+1019 U+101A U+101B U+101C \
             U+101D U+101E U+101F U+1020 U+1021 U+1023 U+1025 U+1029 U+103F \
             U+105A U+105B U+105C U+105D

group(main) using keys

if(opt_e_mode = '1') + [CTRL ALT K_A]  > set(opt_e_mode = '0') save(opt_e_mode)
if(opt_e_mode = '0') + [CTRL ALT K_A]  > set(opt_e_mode = '1') save(opt_e_mode)
if(opt_e_mode = '1') + [SHIFT ALT K_A] > set(opt_e_mode = '0') save(opt_e_mode)
if(opt_e_mode = '0') + [SHIFT ALT K_A] > set(opt_e_mode = '1') save(opt_e_mode)
if(opt_e_mode = '1') + [CTRL ALT K_E]  > set(opt_e_mode = '0') save(opt_e_mode)
if(opt_e_mode = '0') + [CTRL ALT K_E]  > set(opt_e_mode = '1') save(opt_e_mode)
if(opt_e_mode = '1') + [SHIFT ALT K_E] > set(opt_e_mode = '0') save(opt_e_mode)
if(opt_e_mode = '0') + [SHIFT ALT K_E] > set(opt_e_mode = '1') save(opt_e_mode)
if(opt_num_mode = '1') + [SHIFT ALT K_Z] > set(opt_num_mode = '0') save(opt_num_mode)
if(opt_num_mode = '0') + [SHIFT ALT K_Z] > set(opt_num_mode = '1') save(opt_num_mode)


if(opt_num_mode = '1') + [K_NP1] > U+1041
if(opt_num_mode = '1') + [K_NP2] > U+1042
if(opt_num_mode = '1') + [K_NP3] > U+1043
if(opt_num_mode = '1') + [K_NP4] > U+1044
if(opt_num_mode = '1') + [K_NP5] > U+1045
if(opt_num_mode = '1') + [K_NP6] > U+1046
if(opt_num_mode = '1') + [K_NP7] > U+1047
if(opt_num_mode = '1') + [K_NP8] > U+1048
if(opt_num_mode = '1') + [K_NP9] > U+1049
if(opt_num_mode = '1') + [K_NP0] > U+1040

if(opt_num_mode = '0') + [K_NP1] > '1'
if(opt_num_mode = '0') + [K_NP2] > '2'
if(opt_num_mode = '0') + [K_NP3] > '3'
if(opt_num_mode = '0') + [K_NP4] > '4'
if(opt_num_mode = '0') + [K_NP5] > '5'
if(opt_num_mode = '0') + [K_NP6] > '6'
if(opt_num_mode = '0') + [K_NP7] > '7'
if(opt_num_mode = '0') + [K_NP8] > '8'
if(opt_num_mode = '0') + [K_NP9] > '9'
if(opt_num_mode = '0') + [K_NP0] > '0'

U+1004 U+103A U+1039 any(consU) U+1031 + [K_BKSP] > index(consU,4) U+1031
U+1004 U+103A U+1039 any(consU)        + [K_BKSP] > index(consU,4)

any(consU) U+1039 any(consU) U+1031 + [K_BKSP] > index(consU,1) U+1031
U+1039 any(consU) U+1031            + [K_BKSP] > outs(filler) U+1031
U+200B U+1031                       + [K_BKSP] > nul

any(consU) any(mediaU) U+1031 any(aftereU) + [K_BKSP] > index(consU,1) index(mediaU,2) U+1031
any(consU)             U+1031 any(aftereU) + [K_BKSP] > index(consU,1) U+1031
any(consU) any(mediaU) U+1031 any(ldiaU)   + [K_BKSP] > index(consU,1) index(mediaU,2) U+1031
any(consU)             U+1031 any(ldiaU)   + [K_BKSP] > index(consU,1) U+1031
any(consU) any(mediaU) U+1031 any(udia1U)  + [K_BKSP] > index(consU,1) index(mediaU,2) U+1031
any(consU)             U+1031 any(udia1U)  + [K_BKSP] > index(consU,1) U+1031
any(consU) any(mediaU) U+1031 any(udia2U)  + [K_BKSP] > index(consU,1) index(mediaU,2) U+1031
any(consU)             U+1031 any(udia2U)  + [K_BKSP] > index(consU,1) U+1031

any(consU) any(mediaU) any(aftereU) + [K_BKSP] > index(consU,1) index(mediaU,2)
any(consU)             any(aftereU) + [K_BKSP] > index(consU,1)

any(consU) any(mediaU) U+103A any(mediaU) U+1031 + [K_BKSP] > index(consU,1) index(mediaU,2) U+103A outs(filler) U+1031
any(consU) any(mediaU) U+103A U+1031             + [K_BKSP] > index(consU,1) index(mediaU,2) outs(filler) U+1031
any(consU)             U+103A U+1031             + [K_BKSP] > index(consU,1) outs(filler) U+1031
any(mediaU)            U+103A U+1031             + [K_BKSP] > index(mediaU,1) outs(filler) U+1031

any(consU) any(mediaU) any(mediaU) U+1031 + [K_BKSP] > index(consU,1) index(mediaU,2) U+1031
any(consU) any(mediaU) U+1031            + [K_BKSP] > index(consU,1) U+1031
any(consU)             U+1031            + [K_BKSP] > outs(filler) U+1031
any(mediaU)            U+1031            + [K_BKSP] > U+1031

U+1039 any(consU)                       + [K_BKSP] > nul
U+103A U+1031                           + [K_BKSP] > outs(filler) U+1031
U+1031                                  + [K_BKSP] > nul

any(filler) U+1031 + [SHIFT ALT K_Q] > U+1008 U+1031
any(filler) U+1031 + [SHIFT ALT K_I] > U+1004 U+1031
any(filler) U+1031 + [SHIFT K_3]    > U+100B U+1031
any(filler) U+1031 + [SHIFT K_7]    > U+101B U+1031

+ [SHIFT ALT K_Q]       > U+1008
+ [SHIFT ALT K_U]       > U+104D
+ [SHIFT ALT K_R]       > U+104E
+ [SHIFT ALT K_Y]       > U+104C
+ [SHIFT ALT K_I]       > U+1004
+ [SHIFT ALT K_T]       > U+1024
+ [SHIFT ALT K_B]       > U+1050
+ [SHIFT ALT K_N]       > U+1051
+ [SHIFT ALT K_M]       > U+1025 U+102E
