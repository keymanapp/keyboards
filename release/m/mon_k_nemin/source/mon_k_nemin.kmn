+ [SHIFT ALT K_RBRKT]   > U+102A
+ [SHIFT ALT K_BKSLASH] > U+104F
+ [SHIFT ALT K_SLASH]   > U+005C
+ [SHIFT ALT K_4]       > U+1015 U+102D U+102F U+1038
+ [SHIFT ALT K_F]       > U+105A U+103A
+ [SHIFT K_2]          > U+100F U+1039 U+100D
+ [SHIFT K_8]          > U+002A
+ [SHIFT K_5]          > U+0025
+ [SHIFT K_4]          > U+102D U+1032
+ [SHIFT K_3] > U+100B  
+ [SHIFT K_6] > U+1035  
+ [SHIFT K_7] > U+101B 
+ '<' > U+104A
+ '(' > U+0028
+ ')' > U+0029
+ '-' > U+002D
+ '=' > U+003D
+ '_' > U+005F
+ '+' > U+002B
+ "'" > U+0027
+ '"' > U+0022
+ ',' > U+002C
+ '/' > U+002F
+ '?' > U+003F


any(filler) U+1031           + [SHIFT K_I] > U+1004 U+103A U+1039 U+1031
any(consU) U+1031            + [SHIFT K_I] > U+1004 U+103A U+1039 index(consU,1) U+1031
any(consU) any(consU)        + [SHIFT K_I] > index(consU,1) U+1004 U+103A U+1039 index(consU,2)
U+1004 U+103A U+1039 U+1031 + any(mediaK) > U+1004 U+103A U+1039 index(mediaU,5) U+1031
+ [SHIFT K_I]                             > U+1004 U+103A U+1039

U+105A        + any(asatK)  > U+1004 U+103A
U+105A U+103A + any(stackK) > U+1004 U+103A U+1039


platform('touch') any(filler) U+1031 + any(vowelEK) > context
platform('touch')                    + any(vowelEK) > outs(filler) outs(vowelEU)

if(opt_e_mode = '0') + any(vowelEK) > outs(filler) outs(vowelEU)
if(opt_e_mode = '1') + any(vowelEK) > outs(vowelEU)

+ any(stackK) > outs(stackU)

U+101E U+1031 + any(rDiaK) > U+1029 U+1031
U+1007 U+1031 + any(yDiaK) > U+105B U+1031
U+101E        + any(rDiaK) > U+1029
U+1007        + any(yDiaK) > U+105B

any(filler) U+1031 + any(mediaK) > index(mediaU,3) U+1031
any(filler) U+1031 + any(baseK)  > index(baseU,3) U+1031

U+1031 U+1039      + any(baseK)  > U+1039 index(baseU,3) U+1031

any(consU) any(mediaU) U+1031 + any(baseK) > context index(baseU,4)
any(mediaU) U+1031 + any(baseK)  > index(baseU,3) index(mediaU,1) U+1031

U+1031             + any(mediaK) > index(mediaU,2) U+1031
U+1031 any(udia1U) + any(mediaK) > index(mediaU,3) U+1031 index(udia1U,2)
U+1031 any(udia2U) + any(mediaK) > index(mediaU,3) U+1031 index(udia2U,2)

any(consU) any(mediaU) U+1031 any(udia1U) + any(wDiaK) > index(consU,1) index(mediaU,2) index(wDiaU,5) U+1031 index(udia1U,4)
any(consU) any(mediaU) U+1031 any(udia2U) + any(wDiaK) > index(consU,1) index(mediaU,2) index(wDiaU,5) U+1031 index(udia2U,4)
any(consU) U+1031 any(udia1U) + any(wDiaK) > index(consU,1) index(wDiaU,4) U+1031 index(udia1U,3)
any(consU) U+1031 any(udia2U) + any(wDiaK) > index(consU,1) index(wDiaU,4) U+1031 index(udia2U,3)
any(consU) U+1031 any(aftereU) + any(wDiaK) > index(consU,1) index(wDiaU,4) U+1031 index(aftereU,3)
any(consU) U+1031 any(udia1U) + any(mediaNoWK) > index(consU,1) index(mediaNoWU,4) U+1031 index(udia1U,3)
