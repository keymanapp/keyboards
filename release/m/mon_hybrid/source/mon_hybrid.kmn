c mon_hybrid generated from template at 2026-11-14 17:23:39
c with name "Mon Hybrid"
store(&VERSION) '10.0'
store(&NAME) 'Mon Hybrid'
store(&COPYRIGHT) 'Copyright © Nyan Htaw'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'any'
store(&BITMAP) 'mon_hybrid.ico'
store(&VISUALKEYBOARD) 'mon_hybrid.kvks'
store(&LAYOUTFILE) 'mon_hybrid.keyman-touch-layout'

begin Unicode > use(main)

group(main) using keys

c --- Advanced Cluster Reordering & Auto-Correction Rules ---
c 1. Reorder Consonant + Sub-consonant/Virama/Vowel mix (e.g. ကြုိဝ် -> ကြိုဝ်, ယုဵ -> ယဵု)
c If user types Consonant + U+103C (Ro) + U+103E (U) + U+102D (I) + U+103A (Asat)
c Normalizes to standard visual/logical sort order:
U+103E + U+102D > U+102D U+103E c Reorders U and I if typed backwards (e.g. ယုဵ -> ယဵု style/u-i swaps)

c 2. Smart Vowel Auto-Correction for ါ and ာ based on preceding consonant
store(special_consonants) 'ဂဒပဝ'
store(other_chars) 'ကခဃငစဆဇဈဉညဋဌဍဎဏတထဒဓနပဖဗဘမယရလဝသဟဠအသဝရတယုိခပအစဒဖဂဟံကလဍ၌ဇဌဃဗနမ၊။?'

any(special_consonants) + [K_PERIOD] > context(1) U+102B
any(other_chars) + [K_PERIOD] > context(1) U+102C

c --- Smart E-Vowel (ေ) Auto-Flipping ---
store(consonants_list) U+1000 U+1001 U+1002 U+1003 U+1004 U+1005 U+1006 U+1007 U+1008 U+1009 U+100A U+100B U+100C U+100D U+100E U+100F U+1010 U+1011 U+1012 U+1013 U+1014 U+1015 U+1016 U+1017 U+1018 U+1019 U+101A U+101B U+101C U+101D U+101E U+101F U+1020 U+1021 U+105A
U+1031 + any(consonants_list) > context(1) U+1031

c --- Subscript Stacking & Asat ---
+ [K_BKQUOTE] > U+1039
+ [SHIFT K_BKQUOTE] > U+103A

