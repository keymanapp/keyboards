    </File>
    <File>
      <Name>..\LICENSE.md</Name>
      <Description></Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.md</FileType>
    </File>
    <File>
      <Name>..\mon_hybrid_layout.pdf</Name>
      <Description>File mon_hybrid_layout.pdf</Description>
