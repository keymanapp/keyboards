<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.255.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ExecuteProgram></ExecuteProgram>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome.htm</WelcomeFile>
    <MSIFileName></MSIFileName>
    <MSIOptions></MSIOptions>
    <FollowKeyboardVersion/>
  </Options>
  <StartMenu>
    <Folder></Folder>
    <Items/>
  </StartMenu>
  <Info>
    <Name URL="">Mon Hybrid</Name>
    <Copyright URL="">Copyright © Nyan Htaw</Copyright>
    <Author URL="mailto:Nyanhtaw7@gmail.com">Nyan Htaw</Author>
    <Description URL="">This Mon Hybrid keyboard is based on the classic Mon A1 layout, modified to support modern Unicode mapping. Its purpose is to make it easier for Mon people who are familiar with the traditional A1 layout to transition to Mon Unicode typing. Since it already includes muscle memory from the A1 layout, users can adapt more naturally and comfortably without having to learn an entirely new keyboard layout.</Description>
    <Version URL=""></Version>
  </Info>
  <Files>
