<?xml version="1.0" encoding="utf-8"?>
<visualkeyboard>
  <header>
    <version>10.0</version>
    <kbdname>ar25</kbdname>
    <flags/>
  </header>
  <encoding name="unicode" fontname="Arial" fontsize="-12">
    <layer shift="CA">
      <key vkey="K_1">ْ</key>
      <key vkey="K_BKQUOTE">ّ</key>
      <key vkey="K_X">ٍ</key>
      <key vkey="K_Z">ِ</key>
      <key vkey="K_S">ٌ</key>
      <key vkey="K_A">ُ</key>
      <key vkey="K_W">ً</key>
      <key vkey="K_Q">َ</key>
    </layer>
    <layer shift="S">
      <key vkey="K_1">!</key>
      <key vkey="K_QUOTE">/</key>
      <key vkey="K_3">#</key>
      <key vkey="K_4">$</key>
      <key vkey="K_5">%</key>
      <key vkey="K_7">&amp;</key>
      <key vkey="K_9">(</key>
      <key vkey="K_0">)</key>
      <key vkey="K_8">*</key>
      <key vkey="K_EQUAL">+</key>
      <key vkey="K_COLON">:</key>
      <key vkey="K_COMMA">,</key>
      <key vkey="K_PERIOD">.</key>
      <key vkey="K_SLASH">؟</key>
      <key vkey="K_2">@</key>
      <key vkey="K_I">’</key>
      <key vkey="K_J">آ</key>
      <key vkey="K_K">ـ</key>
      <key vkey="K_L">،</key>
      <key vkey="K_M">؛</key>
      <key vkey="K_N">إ</key>
      <key vkey="K_O">&lt;</key>
      <key vkey="K_P">&gt;</key>
      <key vkey="K_Q">[</key>
      <key vkey="K_S">ؤ</key>
      <key vkey="K_U">"</key>
      <key vkey="K_W">]</key>
      <key vkey="K_6">^</key>
      <key vkey="K_HYPHEN">_</key>
      <key vkey="K_LBRKT">{</key>
      <key vkey="K_BKSLASH">|</key>
      <key vkey="K_RBRKT">}</key>
      <key vkey="K_BKQUOTE">~</key>
    </layer>
    <layer shift="">
      <key vkey="K_QUOTE">ط</key>
      <key vkey="K_COMMA">س</key>
      <key vkey="K_HYPHEN">-</key>
      <key vkey="K_PERIOD">ث</key>
      <key vkey="K_SLASH">ئ</key>
      <key vkey="K_0">0</key>
      <key vkey="K_1">1</key>
      <key vkey="K_2">2</key>
      <key vkey="K_3">3</key>
      <key vkey="K_4">4</key>
      <key vkey="K_5">5</key>
      <key vkey="K_6">6</key>
      <key vkey="K_7">7</key>
      <key vkey="K_8">8</key>
      <key vkey="K_9">9</key>
      <key vkey="K_COLON">م</key>
      <key vkey="K_EQUAL">=</key>
      <key vkey="K_LBRKT">ظ</key>
      <key vkey="K_BKSLASH">\</key>
      <key vkey="K_RBRKT">ء</key>
      <key vkey="K_A">ر</key>
      <key vkey="K_B">غ</key>
      <key vkey="K_C">ز</key>
      <key vkey="K_D">ن</key>
      <key vkey="K_E">ة</key>
      <key vkey="K_F">ل</key>
      <key vkey="K_G">ب</key>
      <key vkey="K_H">ت</key>
      <key vkey="K_I">ه</key>
      <key vkey="K_J">ا</key>
      <key vkey="K_K">ع</key>
      <key vkey="K_L">ي</key>
      <key vkey="K_M">ش</key>
      <key vkey="K_N">أ</key>
      <key vkey="K_O">ح</key>
      <key vkey="K_P">ذ</key>
      <key vkey="K_Q">ق</key>
      <key vkey="K_R">د</key>
      <key vkey="K_S">و</key>
      <key vkey="K_T">ف</key>
      <key vkey="K_U">ص</key>
      <key vkey="K_V">ج</key>
      <key vkey="K_W">ى</key>
      <key vkey="K_X">خ</key>
      <key vkey="K_Y">ك</key>
      <key vkey="K_Z">ض</key>
    </layer>
  </encoding>
</visualkeyboard>
